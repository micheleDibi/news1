# Credenziali DB B (Supabase bandi)
# Service key (NON anon key) per write su tabella `fonte`.
SUPABASE_URL_BANDI="https://your-bandi-project.supabase.co"
SUPABASE_SERVICE_KEY_BANDI="your-bandi-service-role-key"

# Pagina sorgente OpenCoesione (override opzionale, default = pagina ufficiale).
# OPENCOESIONE_URL="https://opencoesione.gov.it/it/opportunita_2021_2027/"

# Reachability test (HEAD/GET su ogni link estratto)
REACHABILITY_TIMEOUT_S=15
REACHABILITY_CONCURRENCY=10

# User-Agent per le request (default = browser realistico)
# HTTP_USER_AGENT="Mozilla/5.0 (...) ..."
