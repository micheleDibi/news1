# Credenziali DB B (Supabase bandi)
# Service key (NON anon key) per write su tabella `fonte`.
SUPABASE_URL_BANDI="https://your-bandi-project.supabase.co"
SUPABASE_SERVICE_KEY_BANDI="your-bandi-service-role-key"

# Pagina sorgente OpenCoesione (override opzionale, default = pagina ufficiale).
# OPENCOESIONE_URL="https://opencoesione.gov.it/it/opportunita_2021_2027/"

# Reachability test (HEAD/GET su ogni link estratto)
REACHABILITY_TIMEOUT_S=15
REACHABILITY_CONCURRENCY=10

# User-Agent per le request (default = browser realistico)
# HTTP_USER_AGENT="Mozilla/5.0 (...) ..."

# === Step 2: scraping bandi ===
# Firecrawl API key (paid). Necessaria per le ~18 fonti JS/anti-bot
# (Calabria, Marche/Radware, Lombardia, Puglia, Sardegna, Interreg Europe).
FIRECRAWL_API_KEY=""

# Delay minimo (s) tra request consecutive verso lo stesso host
HOST_THROTTLE_DELAY_S=1.0

# === Step intermedio: pre-processing via LLM ===
# Chiave Anthropic per Claude Haiku 4.5 (validazione + stato bando)
ANTHROPIC_API_KEY=""
# Modello (default Haiku 4.5, costo ~$1/M input + $5/M output)
PREPROCESS_MODEL=claude-haiku-4-5-20251001
# Concorrenza asyncio per chiamate API (default 20 = ~3-5 min su 2820 bandi)
PREPROCESS_CONCURRENCY=20
# Max tokens output (256 e' sufficiente per il tool call JSON)
PREPROCESS_MAX_TOKENS=256

# === Step v7: enrichment via LLM + Firecrawl ===
# Per ogni bando con stato_processing='processed' e stato_bando aperto/in_apertura/null:
#   - Refinement (NULL): Firecrawl + LLM
#   - Classificazione: 7 LLM call paralleli per bando (FK + junction tables)
ENRICH_MODEL=claude-haiku-4-5-20251001
ENRICH_CONCURRENCY=5
ENRICH_CONCURRENCY_REFINE=3
ENRICH_MAX_TOKENS=200

# === Step v9: preprocess v2 (Firecrawl + Haiku + Sonnet fallback) ===
# Concurrency Firecrawl al preprocess (conservativo per rate-limit).
PREPROCESS_FIRECRAWL_CONCURRENCY=5
# Modello fallback per bandi senza markdown del bando o senza link_bando.
# Usa il markdown della FONTE come contesto.
RESOLVER_MODEL=claude-sonnet-4-6
RESOLVER_MAX_TOKENS=1024

# === Step v10: fonti esterne autenticate ===
# Obiettivo Europa (https://www.obiettivoeuropa.com): senza login l'API
# ritorna solo 5 risultati per pagina. Con login si accede a tutti i bandi.
OBIETTIVO_EUROPA_USERNAME=""
OBIETTIVO_EUROPA_PASSWORD=""

# === Step v8: skill SEO (enriched -> completed) ===
# Modello editoriale top-quality per generare contenuto rich + meta SEO.
# Costo stimato: ~$0.15/bando -> ~$60-80 su ~450 bandi.
SEO_MODEL=claude-opus-4-7
SEO_CONCURRENCY=3
SEO_MAX_TOKENS=4000
# Se true (default), verifica reachability HEAD del link_candidatura
# estratto dalla skill; se fallisce, demote a 'missing'.
SEO_REACHABILITY_CHECK=true
