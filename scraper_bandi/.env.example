# Credenziali DB B (Supabase bandi)
# Service key (NON anon key) per write su tabella `fonte`.
SUPABASE_URL_BANDI="https://your-bandi-project.supabase.co"
SUPABASE_SERVICE_KEY_BANDI="your-bandi-service-role-key"

# Pagina sorgente OpenCoesione (override opzionale, default = pagina ufficiale).
# OPENCOESIONE_URL="https://opencoesione.gov.it/it/opportunita_2021_2027/"

# Reachability test (HEAD/GET su ogni link estratto)
REACHABILITY_TIMEOUT_S=15
REACHABILITY_CONCURRENCY=10

# User-Agent per le request (default = browser realistico)
# HTTP_USER_AGENT="Mozilla/5.0 (...) ..."

# === Step 2: scraping bandi ===
# Firecrawl API key (paid). Necessaria per le ~18 fonti JS/anti-bot
# (Calabria, Marche/Radware, Lombardia, Puglia, Sardegna, Interreg Europe).
FIRECRAWL_API_KEY=""

# Delay minimo (s) tra request consecutive verso lo stesso host
HOST_THROTTLE_DELAY_S=1.0

# === Step intermedio: pre-processing via LLM ===
# Chiave Anthropic per Claude Haiku 4.5 (validazione + stato bando)
ANTHROPIC_API_KEY=""
# Modello (default Haiku 4.5, costo ~$1/M input + $5/M output)
PREPROCESS_MODEL=claude-haiku-4-5-20251001
# Concorrenza asyncio per chiamate API (default 20 = ~3-5 min su 2820 bandi)
PREPROCESS_CONCURRENCY=20
# Max tokens output (256 e' sufficiente per il tool call JSON)
PREPROCESS_MAX_TOKENS=256

# === Step v7: enrichment via LLM + Firecrawl ===
# Per ogni bando con stato_processing='processed' e stato_bando aperto/in_apertura/null:
#   - Refinement (NULL): Firecrawl + LLM
#   - Classificazione: 7 LLM call paralleli per bando (FK + junction tables)
ENRICH_MODEL=claude-haiku-4-5-20251001
ENRICH_CONCURRENCY=5
ENRICH_CONCURRENCY_REFINE=3
ENRICH_MAX_TOKENS=200

# === Step v9: preprocess v2 (Firecrawl + Haiku + Sonnet fallback) ===
# Concurrency Firecrawl al preprocess (conservativo per rate-limit).
PREPROCESS_FIRECRAWL_CONCURRENCY=5
# Modello fallback per bandi senza markdown del bando o senza link_bando.
# Usa il markdown della FONTE come contesto.
RESOLVER_MODEL=claude-sonnet-4-6
RESOLVER_MAX_TOKENS=1024

# === Step v10: fonti esterne autenticate ===
# Obiettivo Europa (https://www.obiettivoeuropa.com): senza login l'API
# ritorna solo 5 risultati per pagina. Con login si accede a tutti i bandi.
OBIETTIVO_EUROPA_USERNAME=""
OBIETTIVO_EUROPA_PASSWORD=""

# === Step v8: skill SEO (enriched -> completed) ===
# Modello editoriale top-quality per generare contenuto rich + meta SEO.
# Costo stimato: ~$0.15/bando -> ~$60-80 su ~450 bandi.
SEO_MODEL=claude-opus-4-7
SEO_CONCURRENCY=3
SEO_MAX_TOKENS=4000
# Se true (default), verifica reachability HEAD del link_candidatura
# estratto dalla skill; se fallisce, demote a 'missing'.
SEO_REACHABILITY_CHECK=true

# === v11: monitor delle pagine ufficiali ===
# MONITOR_MODALITA=ombra (default) registra gli eventi senza toccare le
# colonne pubbliche; attivo li applica tutti. Resta ombra.
# MONITOR_TIPI_ATTIVI: i tipi di evento applicati anche in ombra. Solo gli
# eventi nati nel giro e ammessi dai gate diventano applicati e leggibili
# (box «Aggiornamenti»), e la pagina va a IndexNow; gli altri tipi restano in
# ombra, gli eventi registrati prima non si toccano.
# Ammessi: apertura, chiusura, proroga, riapertura, rettifica, sospensione,
# revoca, annullamento_revoca, graduatoria, esito, faq, nuovo_allegato.
# Un valore diverso si ignora, con un [ALLARME] nel journal e in `salute`.
# ATTENZIONE: `proroga` cambia davvero la scheda pubblica. Scrive la nuova
# `data_scadenza` e, quando serve, `stato_bando`, e fa riscrivere la prosa
# con la data nuova.
# Default: vuota (nessun tipo attivo). Il valore del server, ok del
# committente del 30/09/2026, da scrivere nel `.env` al deploy di ottobre:
# MONITOR_TIPI_ATTIVI=faq,nuovo_allegato,graduatoria,esito,proroga
# Giro 3: `tutti` vale i 12 tipi qui sopra. Sospensione, revoca e
# annullamento della revoca restano in ombra finche' non c'e' la
# migrazione 14 e MONITOR_STATI_ESTESI non e' vera.

# === giro 2, percorso A: verifica dello stato sulle pagine ufficiali ===
# Solo i nomi: i default stanno nel codice (app/settings.py). Un valore
# sconosciuto o fuori intervallo torna al default, con un allarme in `salute`
# (configurazione:verifica_stato).
# ombra (default) | attivo. In ombra il passo legge, propone e conta, ma non
# scrive eventi ne' colonne di `bando`.
VERIFICA_STATO_MODALITA=
# Secondi per giro (60-3600, default 1800): l'unico freno della verifica.
VERIFICA_STATO_TETTO_S=
# true (default) | false: rilettura col modello quando nessun lettore decide.
VERIFICA_STATO_USA_MODELLO=
# Giri di sosta prima della pubblicazione di un aperto senza appigli (0-12, default 4).
INGRESSO_SOSTA_GIRI=
# Risorsa di IndicePA (enti.xlsx): serve solo a cambiare quella predefinita.
INDICEPA_URL=

# Nome del servizio del sender per `sorveglia` (default edunews-bandi-sender).
# Commentata: vuota varrebbe «nessun nome», non il default.
# SORVEGLIA_SERVIZIO_SENDER=
# Facoltativa: serve a misurare la vista come anon (vista_ms).
# PUBLIC_SUPABASE_BANDI_ANON_KEY=

# === giro 3: interruttori e tempi dei passi ===
# Solo i nomi: i default stanno nel codice (app/settings.py). Un valore
# sconosciuto o fuori intervallo torna al default, con un allarme in
# `salute` (configurazione:<nome>). Nessun tetto sul numero di bandi: ogni
# passo ha solo un tempo, e chi resta fuori parte per primo al giro dopo.
# ombra (default) | attivo: fusioni dei gemelli (passo e prima della
# pubblicazione) e scrittura dell'import di IndicePA.
GEMELLI_MODALITA=
DOMINI_MODALITA=
# Secondi per passo (60-7200): resolver precoce (default 600), ricontrolli
# delle fonti (3600), verifica dei link (1200), rielaborazione dei
# pubblicati (3600), monitor (3600).
TEMPO_PRECOCE_S=
TEMPO_RICONTROLLI_S=
TEMPO_LINK_VERIFICA_S=
TEMPO_RIELABORAZIONE_S=
TEMPO_MONITOR_S=
# Dismesse con il giro 3 (niente lotti: nessun tetto sul numero di bandi):
# TETTO_CLASSIFICAZIONI_GIORNO, TETTO_FETCH_GIRO, VERIFICA_STATO_TETTO_LETTURE,
# VERIFICA_STATO_MAX_CHIUSURE, VERIFICA_STATO_TETTO_INGRESSO,
# GEMELLI_FUSIONI_PER_GIRO. Nessuno le legge piu'; se sono ancora nel `.env`,
# `salute` ne stampa i nomi come informazione. Si possono togliere.
