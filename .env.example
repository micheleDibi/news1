# OpenAI
OPENAI_API_KEY='sk-proj-your-openai-api-key'

# Database
DATABASE_URL=sqlite:///./test.db

# Firecrawl
FIRECRAWL_API_KEY="fc-your-firecrawl-api-key"

# API Secret Key (used for internal auth between frontend and API routes)
API_SECRET_KEY='your-secret-key-here'
PUBLIC_API_SECRET_KEY='your-secret-key-here'

# Google Speech credentials filename (must be in project root)
CREDENTIALS_GOOGLE_SPEECH="google-credentials.json"

# AWS S3
AWS_ACCESS_KEY_ID='your-aws-access-key-id'
AWS_SECRET_ACCESS_KEY='your-aws-secret-access-key'
AWS_REGION='eu-north-1'
AWS_BUCKET_NAME='your-bucket-name'

# Anthropic (Claude)
ANTHROPIC_API_KEY='sk-ant-your-anthropic-api-key'

# Supabase (DB principale news1 — articoli, interpelli, selezione personale)
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Facebook (for auto-posting from admin panel)
PUBLIC_FACEBOOK_PAGE_ID="your-facebook-page-id"
PUBLIC_FACEBOOK_ACCESS_TOKEN="your-facebook-page-access-token"

# IndexNow (search engine notification)
INDEXNOW_API_KEY='your-indexnow-api-key-hex'

# Backend Python API (used server-side by proxy endpoints)
BACKEND_URL='http://localhost:8000'

# --- Bandi: Supabase dedicato (DB B, progetto scraper OpenCoesione) ---
# Usato dal backend (sender + skill enrichment) con service-role key
SUPABASE_URL_BANDI="https://your-bandi-project.supabase.co"
SUPABASE_SERVICE_KEY_BANDI="your-bandi-service-role-key"
# Usato dal frontend Astro (/bandi e /bandi/[slug]) con anon key + RLS lettura
PUBLIC_SUPABASE_BANDI_URL="https://your-bandi-project.supabase.co"
PUBLIC_SUPABASE_BANDI_ANON_KEY="your-bandi-anon-key"

# --- Bandi: invocazione scraper come subprocess ---
BANDI_SCRAPER_DIR="/root/projects/news1/Scraper-gerarchico-bandi-OpenCoesione-Backend-Python"
# Path al python del venv dedicato (creato con: python -m venv .venv-bandi)
BANDI_SCRAPER_PYTHON="/root/projects/news1/Scraper-gerarchico-bandi-OpenCoesione-Backend-Python/.venv-bandi/bin/python"
# Smoke-test (limit fonti). Lasciare vuoto in produzione per scraping completo.
BANDI_SCRAPER_RUN_LIMIT=""

# --- Bandi: skill enrichment batch ---
BANDI_SKILL_BATCH_SIZE=10
BANDI_SKILL_MAX_ATTEMPTS=3
