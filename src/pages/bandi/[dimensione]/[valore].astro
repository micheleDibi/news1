---
/**
 * Pagina filtro dei bandi: /bandi/regione/valle-d-aosta, /bandi/programma/fse-...,
 * /bandi/settore/..., /bandi/tipologia/...
 *
 * Stesso impianto della lista /bandi (design «Bandi Redesign»): testata scura,
 * barra dei filtri, card, paginazione. La lista e' /bandi con la voce gia'
 * scelta, letta da `caricaBandi` (stesso ordinamento). I controlli portano a
 * /bandi?<dimensione>=<id>&…, che ha lo stesso contenuto; la paginazione resta
 * invece sugli URL statici di questa pagina, quelli indicizzati.
 *
 * Regione e settore sono relazioni molti-a-molti: PostgREST richiede l'embed !inner
 * nella select piu' il filtro sulla colonna puntata (vedi caricaBandi).
 */
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import ElencoBandi from '../../../components/bandi/ElencoBandi.astro';
import Sorelle from '../../../components/filtro/Sorelle.astro';
import { risolvi, sorelle, incrociate, hrefFiltro, hrefHub } from '../../../lib/pagine-filtro';
import { leggiPagina, numeroPagine, rispostaNonTrovata } from '../../../lib/paginazione';
import { metaFiltro, introFiltro, etichettaBreve } from '../../../lib/seo-filtro';
import { configSezione } from '../../../config/pagine-filtro';
import { caricaBandi, conteggiStatoBandi, corpusBandi, gruppiFiltroBandi } from '../../../lib/liste/bandi';
import { datiStrutturatiFiltro } from '../../../lib/filtro/dati-strutturati';
import { valoreDiIds } from '../../../lib/bandi/elenco';
import { todayRomeISO } from '../../../lib/stato-bando';
import type { Valori } from '../../../lib/liste/parametri';

const SEZIONE = 'bandi' as const;
const cfg = configSezione(SEZIONE);
const { dimensione: slugDimensione, valore: slugValore } = Astro.params;

const nonTrovata = () => rispostaNonTrovata(
  'Pagina non trovata',
  'Non ci sono bandi per questo filtro.',
  cfg.basePath,
  'Torna ai bandi',
);

const esito = await risolvi(SEZIONE, slugDimensione!, slugValore!);
if (esito.stato === 'alias') {
  return Astro.redirect(hrefFiltro(SEZIONE, slugDimensione!, esito.slugCanonico), 301);
}
if (esito.stato === 'assente') return nonTrovata();

const { voce, dim } = esito;
const base = hrefFiltro(SEZIONE, dim.slug, voce.slug);

const pag = leggiPagina(Astro.url, base);
if (pag.tipo === 'redirect') return Astro.redirect(pag.href, 301);
if (pag.tipo === 'nonTrovata') return nonTrovata();

// La voce come filtro della lista: tutti i suoi id in un valore solo, lo stesso
// dell'opzione del pannello (gli alias, es. le due righe di FSE+, sono una voce).
const valori: Valori = { [dim.slug]: [valoreDiIds(voce.idsDb)] };
const { righe, totale, errore } = await caricaBandi(valori, pag.pagina);
const pagine = numeroPagine(totale, cfg.perPagina);
if (pag.pagina > pagine || (righe.length === 0 && pag.pagina > 1)) return nonTrovata();

const c = await corpusBandi();
const gruppi = await gruppiFiltroBandi(valori, c);

const meta = metaFiltro(SEZIONE, dim, voce, pag.pagina, pagine, base);

const versoSettori = dim.slug === 'regione' ? await incrociate(SEZIONE, 'regione', voce.slug, 'settore') : [];
const versoProgrammi = dim.slug === 'regione' ? await incrociate(SEZIONE, 'regione', voce.slug, 'programma') : [];
const versoRegioni = dim.slug === 'settore' ? await incrociate(SEZIONE, 'settore', voce.slug, 'regione') : [];

const intro = introFiltro(SEZIONE, dim, voce, [
  ...(versoSettori.length ? [{ dimensione: 'settore', etichettaPlurale: 'Settori', voci: versoSettori }] : []),
  ...(versoRegioni.length ? [{ dimensione: 'regione', etichettaPlurale: 'Regioni', voci: versoRegioni }] : []),
  ...(versoProgrammi.length ? [{ dimensione: 'programma', etichettaPlurale: 'Programmi', voci: versoProgrammi }] : []),
]);

const altre = await sorelle(SEZIONE, dim.slug, voce.slug);
const blocchi = [
  ...(versoSettori.length ? [{ titolo: `Settori ${voce.etichetta}`, voci: versoSettori.map((v) => ({ etichetta: v.etichetta, href: v.href, totale: v.totale })), hrefTutti: hrefHub(SEZIONE, 'settore') }] : []),
  ...(versoProgrammi.length ? [{ titolo: 'Programmi di finanziamento', voci: versoProgrammi.map((v) => ({ etichetta: v.etichetta, href: v.href, totale: v.totale })), hrefTutti: hrefHub(SEZIONE, 'programma') }] : []),
  ...(versoRegioni.length ? [{ titolo: 'Regioni con bandi di questo settore', voci: versoRegioni.map((v) => ({ etichetta: v.etichetta, href: v.href, totale: v.totale })), hrefTutti: hrefHub(SEZIONE, 'regione') }] : []),
  ...(altre.length ? [{ titolo: `Altre ${dim.etichettaPlurale.toLowerCase()}`, voci: altre.map((v) => ({ etichetta: v.etichetta, href: hrefFiltro(SEZIONE, dim.slug, v.slug), totale: v.totale })), hrefTutti: hrefHub(SEZIONE, dim.slug) }] : []),
];

const etichettaCorrente = etichettaBreve(dim, voce);
const struttura = datiStrutturatiFiltro({
  etichettaSezione: cfg.etichetta,
  basePathSezione: cfg.basePath,
  etichettaCorrente,
  base,
  pagina: pag.pagina,
  pagine,
  perPagina: cfg.perPagina,
  nome: meta.h1,
  canonical: meta.canonical,
  itemList: righe.filter((b) => b.slug && b.titolo).map((b) => ({ href: `/bandi/${b.slug}`, title: b.titolo })),
});

// Testata: la prima riga dell'introduzione (numeri reali) a pagina 1, poi solo
// «Pagina N di M», come prima. Le altre righe vanno sotto la lista.
const testoRiga = (riga: (typeof intro)[number]): string => riga.map((s) => s.testo).join('');
const testoTestata = pag.pagina === 1 && intro.length > 0 ? testoRiga(intro[0]) : `Pagina ${pag.pagina} di ${pagine}`;
const altreRighe = pag.pagina === 1 ? intro.slice(1) : [];
---
<Layout title={meta.title} description={meta.description} canonicalUrl={meta.canonical}>
  <script type="application/ld+json" set:html={struttura.breadcrumb} slot="head" />
  {struttura.itemList && <script type="application/ld+json" set:html={struttura.itemList} slot="head" />}
  {struttura.hrefPrec && <link rel="prev" href={`https://edunews24.it${struttura.hrefPrec}`} slot="head" />}
  {struttura.hrefSucc && <link rel="next" href={`https://edunews24.it${struttura.hrefSucc}`} slot="head" />}

  <main class="font-[Poppins,system-ui,sans-serif] text-[#1a2233] antialiased leading-[normal] [&_input::placeholder]:text-[#7b8494]">
    <ElencoBandi
      valori={valori}
      righe={righe}
      totale={totale}
      errore={errore}
      pagina={pag.pagina}
      pagine={pagine}
      basePaginazione={base}
      gruppi={gruppi}
      conteggi={conteggiStatoBandi(c, voce)}
      testata={{
        briciole: [{ etichetta: 'Home', href: '/' }, { etichetta: 'Bandi', href: cfg.basePath }, { etichetta: etichettaCorrente }],
        titolo: meta.h1,
        testo: testoTestata,
        bandofit: 'filtro-hero',
      }}
      oggi={todayRomeISO()}
    >
      {altreRighe.length > 0 && (
        <section class="mt-10 space-y-2 rounded-2xl border border-[#e3e7ee] bg-white p-[22px] text-[14px] leading-[1.6] text-[#3d4657]">
          {altreRighe.map((riga) => (
            <p>
              {riga.map((seg) => seg.tipo === 'link'
                ? <a href={seg.href} class="text-[#004e9c] underline underline-offset-2">{seg.testo}</a>
                : <Fragment>{seg.testo}</Fragment>)}
            </p>
          ))}
        </section>
      )}
      {blocchi.map((b) => (
        <Sorelle titolo={b.titolo} voci={b.voci} hrefTutti={b.hrefTutti} variante="bandi" />
      ))}
    </ElencoBandi>
  </main>
</Layout>
