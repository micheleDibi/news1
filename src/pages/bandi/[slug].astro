---
import Layout from '../../layouts/Layout.astro';
import { format, parseISO, isValid } from 'date-fns';
import { it } from 'date-fns/locale';
import {
  supabaseBandi, loadCatalogo, resolveBandoRelations, BANDO_SELECT_DETTAGLIO, FONTE_BANDI,
  type Bando, type BandoDetail,
} from '../../lib/supabase-bandi';
import { statoEffettivo, todayRomeISO } from '../../lib/stato-bando';
import { corpoBando } from '../../lib/bandi/contenuto';
import { soloPubblicabili } from '../../lib/bandi/domini';
import { badgeStato, partecipazioneAperta, sottotestoStato, testoFonteUfficiale } from '../../lib/bandi/testi-stato';
import { sceltaCta } from '../../lib/bandi/cta';
import { jsonLdBando } from '../../lib/bandi/jsonld';
import { esitoSlug, RITENTA_DOPO_SECONDI, type Lettura } from '../../lib/bandi/slug-storico';
import BandiExpertCta from '../../components/BandiExpertCta.astro';
import { hrefFiltroSePubblicata } from '../../lib/pagine-filtro';
import { generateBreadcrumbStructuredData } from '../../lib/seo';

export const prerender = false;

const { slug } = Astro.params;

// Tabella e predicato di pubblicazione da FONTE_BANDI (src/lib/bandi/pubblicazione.ts):
// sulla tabella `bando` la RLS li applica comunque, ma dalla vista `bando_pubblico`
// il nome cambia. Le colonne sono quelle di BANDO_SELECT_DETTAGLIO: nessuna colonna
// nuova, perche' una colonna assente fa fallire l'intera richiesta con 42703.
let lettura: Lettura<BandoDetail> = { stato: 'errore' };
try {
  // maybeSingle e non single: `single` su zero righe restituisce un errore
  // (PGRST116), e un guasto di lettura diventerebbe indistinguibile da uno slug
  // inesistente. Qui la differenza vale un 503 invece di un 404.
  const { data, error } = await supabaseBandi
    .from(FONTE_BANDI.tabella)
    .select(BANDO_SELECT_DETTAGLIO)
    .eq('slug', slug)
    .maybeSingle();
  if (error) {
    console.error('[scheda bando]', error);
    lettura = { stato: 'errore' };
  } else if (data) {
    const catalogo = await loadCatalogo();
    lettura = { stato: 'ok', riga: await resolveBandoRelations(data as unknown as Bando, catalogo) };
  } else {
    lettura = { stato: 'ok', riga: null };
  }
} catch (e) {
  console.error('[scheda bando]', e);
  lettura = { stato: 'errore' };
}

// La mappa degli slug storici (`bando_slug_storico`, `bando_fusione`) nasce con
// le migrazioni 02-05: in questo rilascio non esiste ancora, quindi la lettura
// non si fa e uno slug ignoto resta 404 — passando pero' dalla stessa funzione
// che in F2 emettera' 301 e 410.
const esito = esitoSlug({ scheda: lettura, storico: { stato: 'non_eseguita' } });

if (esito.stato === 503) {
  // Mai `noindex` su un guasto temporaneo: sarebbe l'unico modo di trasformare
  // un timeout di PostgREST (anon ha 3 s) in una deindicizzazione.
  return new Response(
    `<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8"><title>503 - Servizio non disponibile</title></head><body style="font-family:system-ui;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0"><div style="text-align:center"><h1 style="font-size:6rem;color:#f59e0b;margin:0">503</h1><p style="font-size:1.5rem;font-weight:bold">Servizio momentaneamente non disponibile</p><p>Non riusciamo a leggere questa scheda. Riprova fra qualche istante.</p><a href="/bandi" style="display:inline-block;margin-top:1rem;padding:0.5rem 1rem;background:#2563eb;color:white;border-radius:0.375rem;text-decoration:none">Torna ai bandi</a></div></body></html>`,
    {
      status: 503,
      headers: {
        'Content-Type': 'text/html',
        'Retry-After': String(RITENTA_DOPO_SECONDI),
        'Cache-Control': 'no-store',
      },
    },
  );
}

if (esito.stato === 301) return Astro.redirect(esito.destinazione, 301);

if (esito.stato === 410) {
  return new Response(
    `<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8"><meta name="robots" content="noindex"><title>410 - Contenuto rimosso</title></head><body style="font-family:system-ui;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0"><div style="text-align:center"><h1 style="font-size:6rem;color:#ef4444;margin:0">410</h1><p style="font-size:1.5rem;font-weight:bold">Contenuto rimosso</p><p>Questo bando non è più disponibile.</p><a href="/bandi" style="display:inline-block;margin-top:1rem;padding:0.5rem 1rem;background:#2563eb;color:white;border-radius:0.375rem;text-decoration:none">Torna ai bandi</a></div></body></html>`,
    { status: 410, headers: { 'Content-Type': 'text/html', 'X-Robots-Tag': 'noindex' } },
  );
}

if (esito.stato === 404 || lettura.stato !== 'ok' || lettura.riga === null) {
  return new Response(
    `<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8"><meta name="robots" content="noindex"><title>404 - Bando non trovato</title></head><body style="font-family:system-ui;display:flex;align-items:center;justify-content:center;min-height:100vh;margin:0"><div style="text-align:center"><h1 style="font-size:6rem;color:#ef4444;margin:0">404</h1><p style="font-size:1.5rem;font-weight:bold">Bando non trovato</p><p>Il bando richiesto non esiste o e' stato rimosso.</p><a href="/bandi" style="display:inline-block;margin-top:1rem;padding:0.5rem 1rem;background:#2563eb;color:white;border-radius:0.375rem;text-decoration:none">Torna ai bandi</a></div></body></html>`,
    { status: 404, headers: { 'Content-Type': 'text/html', 'X-Robots-Tag': 'noindex' } },
  );
}

const bando: BandoDetail = lettura.riga;

// Corpo editoriale: link filtrati, FAQ nella forma giusta, `contenuto` stringa
// o malformato gestito senza far cadere la scheda (src/lib/bandi/contenuto.ts).
// Una passata sola: l'avviso segue il corpo reso davvero, non il numero di
// sezioni, cosi' una scheda muta non resta anche senza avviso.
const { html: corpoHtml, avviso: avvisoCorpo } = corpoBando(bando.contenuto);

const formatDate = (s: string | null | undefined): string => {
  if (!s) return '—';
  try {
    const d = parseISO(s);
    if (!isValid(d)) return s;
    return format(d, 'd MMMM yyyy', { locale: it });
  } catch {
    return s;
  }
};

const formatImporto = (n: number | null): string => {
  if (n == null) return '—';
  return new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
};

// «Oggi» di Roma, fissato una volta: badge, sottotesto e conteggio non devono
// poter cadere a cavallo della mezzanotte l'uno rispetto all'altro.
const oggi = todayRomeISO();

const stato = statoEffettivo({ stato: bando.stato_bando, data_scadenza: bando.data_scadenza });
const badge = badgeStato(stato);
const sottotesto = sottotestoStato({
  stato,
  data_apertura: bando.data_apertura,
  data_scadenza: bando.data_scadenza,
  oggi,
});
// Su un sospeso o un revocato spariscono CTA e conto alla rovescia: invitare a
// candidarsi a un bando revocato e' peggio che non dire niente.
const partecipabile = partecipazioneAperta(stato);

// F1: la fonte ufficiale non ha ancora colonne (le crea la migrazione 01), e
// `ultimo_controllo_at` vive in `bando_controllo` (migrazione 02). La riga dice
// quindi «Fonte ufficiale in verifica», che e' la verita' di oggi.
const rigaFonte = testoFonteUfficiale(null, null);

const daysToDeadline = (() => {
  // Giorni rispetto a oggi-Europe/Rome, stesso ancoraggio del badge: col fuso
  // del server (UTC in prod) badge e conteggio divergerebbero nella finestra
  // tra la mezzanotte di Roma e quella UTC.
  if (!bando.data_scadenza) return null;
  const scad = String(bando.data_scadenza).slice(0, 10);
  if (!/^\d{4}-\d{2}-\d{2}$/.test(scad)) return null;
  return Math.round((Date.parse(scad) - Date.parse(oggi)) / 86400000);
})();

// Alias compat: il template usa bando.tipologia / bando.programma / bando.beneficiari
// / bando.codici_ateco / bando.modalita_erogazione come stringhe. Li popolo dai
// nomi risolti via resolveBandoRelations().
const alias = bando as unknown as Record<string, unknown>;
alias.tipologia = bando.tipologia_nome;
alias.programma = bando.programma_nome;

// Link verso le pagine filtro, solo dove esistono davvero (mai verso un 404).
const hrefTipologia = hrefFiltroSePubblicata('bandi', 'tipologia', bando.tipologia_nome);
const hrefProgramma = hrefFiltroSePubblicata('bandi', 'programma', bando.programma_nome);
alias.modalita_erogazione = bando.modalita_nome;
alias.beneficiari = bando.beneficiari_nomi;
alias.codici_ateco = bando.codici_ateco_resolved.map(c =>
  c.descrizione ? `${c.codice} — ${c.descrizione}` : c.codice
);

// CTA: in F1 l'unico ingresso e' `link_candidatura` con source='extracted'.
// `link_bando` non e' piu' nemmeno selezionato: era l'URL sull'aggregatore, e
// il ripiego su di lui ci mandava 94 CTA su 230.
const cta = partecipabile
  ? sceltaCta({
      candidaturaEstratta: bando.link_candidatura_source === 'extracted' ? bando.link_candidatura : null,
    })
  : null;

// Allegati: la stessa cintura di ogni altro URL in uscita. In F1 la fonte resta
// la colonna `bando.allegati`; da F2 arrivano da `bando_link` tipo 'allegato'.
const allegati = soloPubblicabili(bando.allegati, a => a?.url);

// Tipo allegato → icona/colore
const allegatoTipoLabel = (tipo: string): string => {
  if (tipo === 'pdf') return 'PDF';
  if (tipo === 'doc' || tipo === 'docx') return 'DOC';
  if (tipo === 'xls' || tipo === 'xlsx' || tipo === 'ods') return 'XLS';
  if (tipo === 'odt' || tipo === 'rtf') return 'TXT';
  if (tipo === 'zip') return 'ZIP';
  return 'FILE';
};

const allegatoTipoClasses = (tipo: string): string => {
  if (tipo === 'pdf') return 'bg-red-50 text-red-700';
  if (tipo === 'doc' || tipo === 'docx' || tipo === 'odt' || tipo === 'rtf') return 'bg-blue-50 text-blue-700';
  if (tipo === 'xls' || tipo === 'xlsx' || tipo === 'ods') return 'bg-green-50 text-green-700';
  if (tipo === 'zip') return 'bg-amber-50 text-amber-700';
  return 'bg-gray-100 text-gray-600';
};

// v4: meta_title/meta_description NON sono piu' colonne. Li derivo da titolo/descrizione_breve.
const titoloDisplay = bando.titolo || 'Bando';
const canonicalUrl = `https://edunews24.it/bandi/${bando.slug}`;

// Troncamento a confine di PAROLA, non all'ultimo punto (truncateAtDot):
// titoli e testi dei bandi sono pieni di abbreviazioni puntate (D.M., n.,
// S.p.A.) e importi con punti delle migliaia, che un taglio "al punto"
// mutilerebbe ("Decreto Ministeriale n.", "Dotazione 1.000.").
const truncateAtWord = (text: string, maxLen: number): string => {
  if (text.length <= maxLen) return text;
  const sub = text.slice(0, maxLen - 1);
  const lastSpace = sub.lastIndexOf(' ');
  return (lastSpace > 0 ? sub.slice(0, lastSpace) : sub).replace(/[\s,;:.]+$/, '') + '…';
};

// Title col brand quando rientra nel budget (budget 70 come le pagine articolo).
const titleSuffix = ' - EduNews24';
const metaTitle = titoloDisplay.length + titleSuffix.length <= 70
  ? titoloDisplay + titleSuffix
  : truncateAtWord(titoloDisplay, 70);

// Description mai vuota: descrizione_breve, altrimenti composta dai campi
// presenti (aggiungendo ogni frase SOLO se ci sta intera, per non spezzare
// date o importi), altrimenti default di sezione.
const metaDescription = (() => {
  if (bando.descrizione_breve) return truncateAtWord(bando.descrizione_breve, 155);
  const parts: string[] = [];
  if (bando.data_scadenza) parts.push(`Scadenza ${formatDate(bando.data_scadenza)}.`);
  if (bando.importo_totale_eur != null) parts.push(`Dotazione ${formatImporto(bando.importo_totale_eur)}.`);
  parts.push('Requisiti e candidatura su EduNews24.');
  let desc = truncateAtWord(
    bando.ente_erogatore ? `${titoloDisplay}: bando di ${bando.ente_erogatore}.` : `${titoloDisplay}.`,
    155,
  );
  for (const part of parts) {
    if (desc.length + 1 + part.length <= 155) desc += ` ${part}`;
  }
  return desc;
})();

// JSON-LD dal builder (src/lib/bandi/jsonld.ts): Article + about:MonetaryGrant,
// `sameAs` solo con una fonte ufficiale trovata — in F1 quindi mai — e nessun
// FAQPage. Prima `sameAs` valeva `link_bando`, cioe' l'aggregatore.
const jsonLd = jsonLdBando({
  urlCanonico: canonicalUrl,
  titolo: titoloDisplay,
  titoloBreve: bando.titolo_breve,
  descrizione: bando.descrizione_breve,
  dataPubblicazione: bando.data_pubblicazione,
  dataModifica: bando.updated_at ? new Date(bando.updated_at).toISOString() : null,
  enteErogatore: bando.ente_erogatore,
  areaGeografica: bando.area_geografica,
  beneficiari: bando.beneficiari_nomi,
  tematiche: bando.tematica,
  importoTotaleEur: bando.importo_totale_eur,
  fonteUfficiale: null,
});

const breadcrumbStructuredData = generateBreadcrumbStructuredData({
  category: 'Bandi',
  category_slug: 'bandi',
  slug: bando.slug,
  title: titoloDisplay,
});
---

<Layout
  title={metaTitle}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  image="https://edunews24.it/og-bandi.png"
  ogType="article"
  publishedTime={bando.data_pubblicazione || undefined}
  modifiedTime={bando.updated_at ? new Date(bando.updated_at).toISOString() : undefined}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={breadcrumbStructuredData} />
  </Fragment>

  <main class="bg-gray-50 min-h-screen">
    <div class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white py-10 px-4 sm:px-6 lg:px-8">
      <div class="container mx-auto max-w-6xl">
        <nav class="flex text-sm text-blue-200 mb-4" aria-label="Breadcrumb">
          <ol class="inline-flex items-center space-x-1">
            <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
            <li class="flex items-center">
              <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
              <a href="/bandi" class="hover:text-white transition-colors">Bandi</a>
            </li>
            <li class="flex items-center">
              <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
              <span class="text-white font-medium line-clamp-1">{titoloDisplay}</span>
            </li>
          </ol>
        </nav>
        {bando.titolo_breve && (
          <p class="text-blue-200 text-sm uppercase tracking-wider mb-2">{bando.titolo_breve}</p>
        )}
        <h1 class="text-2xl md:text-4xl font-bold mb-3 leading-tight">{titoloDisplay}</h1>
        <div class="flex flex-wrap items-center gap-3 text-sm">
          {bando.tipologia && (
            hrefTipologia
              ? <a href={hrefTipologia} class="inline-flex items-center px-2.5 py-1 rounded-md bg-white/20 backdrop-blur-sm font-semibold hover:bg-white/30 transition-colors">{bando.tipologia}</a>
              : <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-white/20 backdrop-blur-sm font-semibold">{bando.tipologia}</span>
          )}
          {bando.ente_erogatore && (
            <span class="inline-flex items-center gap-1.5 text-blue-100">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5"/></svg>
              {bando.ente_erogatore}
            </span>
          )}
          {bando.area_geografica && (
            <span class="inline-flex items-center gap-1.5 text-blue-100">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/></svg>
              {bando.area_geografica}
            </span>
          )}
          <span class={`inline-flex items-center px-2.5 py-1 rounded-full font-semibold ${badge.classi}`}>{badge.etichetta}</span>
        </div>
        {sottotesto && (
          <p class="text-blue-100 text-sm mt-3 max-w-3xl">{sottotesto}</p>
        )}
        <p class="text-blue-200 text-xs mt-1.5">{rigaFonte}</p>
      </div>
    </div>

    <div class="container mx-auto px-4 max-w-6xl py-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {/* Main content */}
        <article class="lg:col-span-2 bg-white rounded-xl shadow-sm border border-gray-100 p-6 sm:p-8">
          {bando.descrizione_breve && (
            <p class="text-lg text-gray-700 leading-relaxed mb-6 font-medium">{bando.descrizione_breve}</p>
          )}
          {avvisoCorpo && (
            <p class="text-sm text-amber-800 bg-amber-50 border border-amber-200 rounded-lg px-4 py-3 mb-6">{avvisoCorpo}</p>
          )}
          <div class="prose prose-blue max-w-none" set:html={corpoHtml} />
        </article>

        {/* Sidebar */}
        <aside class="space-y-4">
          {/* CTA — una sola, e solo se la destinazione e' affidabile.
              Nessun box e' meglio di un box che porta a un aggregatore. */}
          {cta && (
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
              <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Partecipa al bando</h3>
              <a
                href={cta.url}
                target="_blank"
                rel="noopener noreferrer"
                class="block w-full text-center px-4 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors"
              >
                {cta.etichetta}
                <svg class="inline w-4 h-4 ml-1.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
              </a>
            </div>
          )}

          {/* Banner CTA "Hai bisogno di un esperto?" */}
          <BandiExpertCta variant="sidebar" utmContent="dettaglio-sidebar" />

          {/* Documenti e allegati */}
          {allegati.length > 0 && (
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
              <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Documenti e allegati</h3>
              <ul class="space-y-2">
                {allegati.map(a => (
                  <li>
                    <a
                      href={a.url}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="flex items-start gap-2.5 text-sm text-gray-700 hover:text-blue-700 transition-colors group"
                    >
                      <span class={`shrink-0 inline-flex items-center justify-center min-w-[2.25rem] px-1.5 py-0.5 rounded text-[10px] font-bold mt-0.5 ${allegatoTipoClasses(a.tipo)}`}>
                        {allegatoTipoLabel(a.tipo)}
                      </span>
                      <span class="flex-1 leading-snug group-hover:underline">{a.label}</span>
                      <svg class="shrink-0 w-3.5 h-3.5 text-gray-400 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Pubblicazione (data della fonte, NON la nostra) */}
          {bando.data_pubblicazione && (
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
              <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Data di pubblicazione</h3>
              <p class="text-lg font-semibold text-gray-900">
                {formatDate(bando.data_pubblicazione)}
              </p>
            </div>
          )}

          {/* Apertura: la colonna data_apertura era selezionata e non veniva
              mai resa, e con lei spariva l'unica spiegazione del badge
              "In apertura". */}
          {bando.data_apertura && (
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
              <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Apertura</h3>
              <p class="text-lg font-semibold text-gray-900">{formatDate(bando.data_apertura)}</p>
              <p class="text-sm text-gray-500 mt-1">Data indicata dalla fonte</p>
            </div>
          )}

          {/* Scadenza */}
          {bando.data_scadenza && (
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
              <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Scadenza</h3>
              <p class="text-2xl font-bold text-gray-900">{formatDate(bando.data_scadenza)}</p>
              {partecipabile && daysToDeadline != null && (
                <p class="text-sm text-gray-500 mt-1">
                  {daysToDeadline > 0
                    ? `${daysToDeadline} giorni rimanenti`
                    : daysToDeadline === 0
                    ? 'Scade oggi'
                    : `Scaduto da ${-daysToDeadline} giorni`}
                </p>
              )}
            </div>
          )}

          {/* Importi */}
          {(bando.importo_totale_eur != null || bando.importo_max_per_progetto_eur != null) && (
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
              <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Importi</h3>
              {bando.importo_totale_eur != null && (
                <div class="mb-2">
                  <p class="text-xs text-gray-500">Totale stanziato</p>
                  <p class="text-lg font-bold text-gray-900">{formatImporto(bando.importo_totale_eur)}</p>
                </div>
              )}
              {bando.importo_max_per_progetto_eur != null && (
                <div>
                  <p class="text-xs text-gray-500">Massimo per progetto</p>
                  <p class="text-lg font-bold text-gray-900">{formatImporto(bando.importo_max_per_progetto_eur)}</p>
                </div>
              )}
            </div>
          )}

          {/* Beneficiari */}
          {bando.beneficiari && bando.beneficiari.length > 0 && (
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
              <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">A chi si rivolge</h3>
              <ul class="space-y-1.5">
                {bando.beneficiari.map(b => (
                  <li class="text-sm text-gray-700 flex items-start gap-2">
                    <svg class="w-4 h-4 text-blue-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    {b}
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Tematica */}
          {bando.tematica && bando.tematica.length > 0 && (
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
              <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Tematica</h3>
              <div class="flex flex-wrap gap-2">
                {bando.tematica.map(t => (
                  <span class="inline-flex items-center px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 text-xs font-medium">{t}</span>
                ))}
              </div>
            </div>
          )}

          {/* Codici ATECO */}
          {bando.codici_ateco && bando.codici_ateco.length > 0 && (
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
              <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Codici ATECO</h3>
              <ul class="space-y-1.5">
                {bando.codici_ateco.map(c => (
                  <li class="text-sm text-gray-700 flex items-start gap-2">
                    <svg class="w-4 h-4 text-blue-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                    <span class="leading-snug">{c}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          {/* Programma + Modalita */}
          {(bando.programma || bando.modalita_erogazione) && (
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5">
              <h3 class="text-sm font-semibold text-gray-500 uppercase tracking-wider mb-3">Programma e modalita</h3>
              {bando.programma && (
                <div class="mb-3">
                  <p class="text-xs text-gray-500 mb-0.5">Programma</p>
                  {hrefProgramma
                    ? <p class="text-sm font-medium"><a href={hrefProgramma} class="text-blue-700 hover:underline">{bando.programma}</a></p>
                    : <p class="text-sm font-medium text-gray-800">{bando.programma}</p>}
                </div>
              )}
              {bando.modalita_erogazione && (
                <div>
                  <p class="text-xs text-gray-500 mb-0.5">Modalita erogazione</p>
                  <p class="text-sm font-medium text-gray-800">{bando.modalita_erogazione}</p>
                </div>
              )}
            </div>
          )}
        </aside>
      </div>
    </div>
  </main>
</Layout>
