---
import Layout from '../../layouts/Layout.astro';
import { format, parseISO, isValid } from 'date-fns';
import { it } from 'date-fns/locale';
import {
  supabaseBandi, loadCatalogo, resolveBandoRelations, BANDO_SELECT_DETTAGLIO, FONTE_BANDI,
  F2_DISPONIBILE, caricaLinkEEventi, risolviSlugStorico,
  type Bando, type BandoDetail,
} from '../../lib/supabase-bandi';
import { statoEffettivo, todayRomeISO } from '../../lib/stato-bando';
import { corpoBando } from '../../lib/bandi/contenuto';
import { soloPubblicabili } from '../../lib/bandi/domini';
import {
  giorniAllaScadenza, oraItaliana, partecipazioneAperta, rigaScadenza, sottotestoStato,
  testoFonteUfficiale, testoGiorniMancanti,
} from '../../lib/bandi/testi-stato';
import { aspettoStato, inScadenza, PALETTE_SCADENZA } from '../../lib/bandi/aspetto';
import { calendario } from '../../lib/bandi/calendario';
import { eur } from '../../lib/bandi/elenco';
import { sceltaCta } from '../../lib/bandi/cta';
import { statoDaEventi, vociAggiornamento } from '../../lib/bandi/aggiornamenti';
import { jsonLdBando } from '../../lib/bandi/jsonld';
import { esitoSlug, RITENTA_DOPO_SECONDI, type Lettura } from '../../lib/bandi/slug-storico';
import BandiExpertCta from '../../components/BandiExpertCta.astro';
import { hrefFiltroSePubblicata } from '../../lib/pagine-filtro';
import { generateBreadcrumbStructuredData } from '../../lib/seo';

export const prerender = false;

const { slug } = Astro.params;

// Tabella e predicato di pubblicazione da FONTE_BANDI (src/lib/bandi/pubblicazione.ts):
// sulla tabella `bando` la RLS li applica comunque, ma dalla vista `bando_pubblico`
// il nome cambia. Le colonne sono quelle di BANDO_SELECT_DETTAGLIO: nessuna colonna
// nuova, perche' una colonna assente fa fallire l'intera richiesta con 42703.
let lettura: Lettura<BandoDetail> = { stato: 'errore' };
try {
  // maybeSingle e non single: `single` su zero righe restituisce un errore
  // (PGRST116), e un guasto di lettura diventerebbe indistinguibile da uno slug
  // inesistente. Qui la differenza vale un 503 invece di un 404.
  const { data, error } = await supabaseBandi
    .from(FONTE_BANDI.tabella)
    .select(BANDO_SELECT_DETTAGLIO)
    .eq('slug', slug)
    .maybeSingle();
  if (error) {
    console.error('[scheda bando]', error);
    lettura = { stato: 'errore' };
  } else if (data) {
    const catalogo = await loadCatalogo();
    lettura = { stato: 'ok', riga: await resolveBandoRelations(data as unknown as Bando, catalogo) };
  } else {
    lettura = { stato: 'ok', riga: null };
  }
} catch (e) {
  console.error('[scheda bando]', e);
  lettura = { stato: 'errore' };
}

// La mappa degli slug storici (`bando_slug_storico`, `bando_fusione`) si legge
// solo quando lo slug richiesto non ha dato una scheda: e' il caso raro, e
// pagarla su ogni pagina sarebbe due richieste in piu' per niente. Sulla
// tabella `bando` la lettura non si fa affatto (`risolviSlugStorico` risponde
// `non_eseguita`) e uno slug ignoto resta 404, come in F1.
const storico = lettura.stato === 'ok' && lettura.riga === null
  ? await risolviSlugStorico(String(slug))
  : { stato: 'non_eseguita' as const };
const esito = esitoSlug({ scheda: lettura, storico });

/**
 * HTML delle pagine d'errore della scheda: autosufficiente (niente Layout, che
 * interroga il DB principale), CSS nel documento, nessuna dipendenza. Produce
 * SOLO l'HTML: status e header li decide ciascun ramo. `noindex` e' obbligatorio
 * e senza default, perche' il 503 non deve mai averlo (vedi sotto).
 */
const paginaErrore = (pagina: {
  codice: 404 | 410 | 503;
  titoloPagina: string;
  titolo: string;
  testo: string;
  noindex: boolean;
}): string =>
  '<!DOCTYPE html><html lang="it"><head><meta charset="UTF-8">' +
  '<meta name="viewport" content="width=device-width, initial-scale=1">' +
  (pagina.noindex ? '<meta name="robots" content="noindex">' : '') +
  `<title>${pagina.titoloPagina}</title>` +
  '<style>' +
  'body{margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#f9fafb;' +
  'color:#111827;font-family:system-ui,-apple-system,"Segoe UI",sans-serif;line-height:1.5}' +
  'main{max-width:32rem;padding:2rem 1.5rem}' +
  '.codice{margin:0;font-size:.875rem;color:#4b5563}' +
  'h1{margin:.5rem 0 0;font-size:1.5rem;line-height:1.25}' +
  '.testo{margin:.75rem 0 0;color:#374151}' +
  'a{display:inline-block;margin-top:1.5rem;padding:.75rem 1.25rem;background:#004e9c;color:#fff;' +
  'border-radius:.375rem;text-decoration:none;font-weight:600}' +
  'a:hover{background:#003d7a}a:focus-visible{outline:2px solid #004e9c;outline-offset:3px}' +
  '</style></head><body><main>' +
  `<p class="codice">Errore ${pagina.codice}</p><h1>${pagina.titolo}</h1><p class="testo">${pagina.testo}</p>` +
  '<a href="/bandi">Torna ai bandi</a></main></body></html>';

if (esito.stato === 503) {
  // Mai `noindex` su un guasto temporaneo: sarebbe l'unico modo di trasformare
  // un timeout di PostgREST (anon ha 3 s) in una deindicizzazione.
  return new Response(
    paginaErrore({
      codice: 503,
      titoloPagina: '503 - Servizio non disponibile',
      titolo: 'Servizio momentaneamente non disponibile',
      testo: 'Non riusciamo a leggere questa scheda. Riprova fra qualche istante.',
      noindex: false,
    }),
    {
      status: 503,
      headers: {
        'Content-Type': 'text/html',
        'Retry-After': String(RITENTA_DOPO_SECONDI),
        'Cache-Control': 'no-store',
      },
    },
  );
}

if (esito.stato === 301) return Astro.redirect(esito.destinazione, 301);

if (esito.stato === 410) {
  return new Response(
    paginaErrore({
      codice: 410,
      titoloPagina: '410 - Contenuto rimosso',
      titolo: 'Contenuto rimosso',
      testo: 'Questo bando non è più disponibile.',
      noindex: true,
    }),
    { status: 410, headers: { 'Content-Type': 'text/html', 'X-Robots-Tag': 'noindex' } },
  );
}

if (esito.stato === 404 || lettura.stato !== 'ok' || lettura.riga === null) {
  return new Response(
    paginaErrore({
      codice: 404,
      titoloPagina: '404 - Bando non trovato',
      titolo: 'Bando non trovato',
      testo: 'Il bando richiesto non esiste o è stato rimosso.',
      noindex: true,
    }),
    { status: 404, headers: { 'Content-Type': 'text/html', 'X-Robots-Tag': 'noindex' } },
  );
}

const bando: BandoDetail = lettura.riga;

// Corpo editoriale: link filtrati, FAQ nella forma giusta, `contenuto` stringa
// o malformato gestito senza far cadere la scheda (src/lib/bandi/contenuto.ts).
// Una passata sola: l'avviso segue il corpo reso davvero, non il numero di
// sezioni, cosi' una scheda muta non resta anche senza avviso.
const { html: corpoHtml, avviso: avvisoCorpo } = corpoBando(bando.contenuto);

const formatDate = (s: string | null | undefined): string => {
  if (!s) return '—';
  try {
    const d = parseISO(s);
    if (!isValid(d)) return s;
    return format(d, 'd MMMM yyyy', { locale: it });
  } catch {
    return s;
  }
};

const formatImporto = (n: number | null): string => {
  if (n == null) return '—';
  return new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 }).format(n);
};

// «Oggi» di Roma, fissato una volta: badge, sottotesto e conteggio non devono
// poter cadere a cavallo della mezzanotte l'uno rispetto all'altro.
const oggi = todayRomeISO();

/**
 * Le colonne che esistono solo sulla vista, lette senza pretendere che ci
 * siano. La select le chiede solo dalla fonte giusta (`BANDO_SELECT_DETTAGLIO`),
 * quindi qui non si sa a compile time se il campo c'e': un accesso diretto
 * sarebbe un errore di tipo, e un cast su tutto il bando perderebbe i tipi
 * delle colonne vere.
 */
const colonne = bando as unknown as Record<string, unknown>;
const campo = (nome: string): unknown => colonne[nome];
const campoTesto = (nome: string): string | null => {
  const valore = colonne[nome];
  return typeof valore === 'string' && valore !== '' ? valore : null;
};

// I link e gli eventi del bando: due letture sole, e solo se la fonte le ha.
const { link: linkBando, eventi } = await caricaLinkEEventi(bando.id);
const aggiornamenti = vociAggiornamento(eventi);

// Lo stato: dalla vista arriva gia' calcolato (`stato_effettivo`), altrimenti si
// calcola qui dalla colonna. In piu', finche' la migrazione 06 non estende il
// CHECK a cinque valori, una sospensione o una revoca verificata resta
// `applicato=false`: la colonna dice «aperto» e la verita' sta nell'evento.
const statoDalDb = (bando as unknown as Record<string, unknown>).stato_effettivo;
const statoRegistrato = typeof statoDalDb === 'string' && statoDalDb !== ''
  ? (statoDalDb as typeof stato)
  : statoEffettivo({
      stato: bando.stato_bando,
      data_scadenza: bando.data_scadenza,
      data_apertura: bando.data_apertura,
      data_apertura_verificata: campo('data_apertura_verificata') === true,
      ora_apertura: campoTesto('ora_apertura'),
      ora_scadenza: campoTesto('ora_scadenza'),
    });
const stato = statoDaEventi(eventi) ?? statoRegistrato;
const aspetto = aspettoStato(stato);
const sottotesto = sottotestoStato({
  stato,
  data_apertura: bando.data_apertura,
  data_apertura_verificata: campo('data_apertura_verificata') === true,
  data_scadenza: bando.data_scadenza,
  ora_scadenza: campoTesto('ora_scadenza'),
  data_scadenza_verificata: campo('data_scadenza_verificata') === true,
  oggi,
});
// Su un sospeso o un revocato spariscono CTA e conto alla rovescia: invitare a
// candidarsi a un bando revocato e' peggio che non dire niente.
const partecipabile = partecipazioneAperta(stato);

// La fonte ufficiale e la data dell'ultimo controllo: le porta la vista. Sulla
// tabella quelle colonne non ci sono e la riga resta «Fonte ufficiale in
// verifica», che e' la verita' di quella configurazione.
const fonteUfficiale = F2_DISPONIBILE && campoTesto('fonte_ufficiale_stato') !== null
  ? {
      stato: campoTesto('fonte_ufficiale_stato') as 'trovata' | 'in_verifica' | 'non_trovata',
      url: campoTesto('fonte_ufficiale_url'),
      host: campoTesto('fonte_ufficiale_host'),
      tipo: campoTesto('fonte_ufficiale_tipo') as 'ente' | 'portale_pubblico' | null,
      e_atto: campo('fonte_ufficiale_e_atto') === true,
      verificata_il: campoTesto('fonte_ufficiale_verificata_at'),
    }
  : null;
const rigaFonte = testoFonteUfficiale(fonteUfficiale, campoTesto('ultimo_controllo_at'));

// Giorni rispetto a oggi-Europe/Rome, stesso ancoraggio del badge: col fuso
// del server (UTC in prod) badge e conteggio divergerebbero nella finestra
// tra la mezzanotte di Roma e quella UTC. La formula sta in testi-stato.ts,
// condivisa con la card della lista.
const daysToDeadline = giorniAllaScadenza(bando.data_scadenza, oggi);

// Link verso le pagine filtro, solo dove esistono davvero (mai verso un 404).
const hrefTipologia = hrefFiltroSePubblicata('bandi', 'tipologia', bando.tipologia_nome);
const hrefProgramma = hrefFiltroSePubblicata('bandi', 'programma', bando.programma_nome);
const codiciAteco = bando.codici_ateco_resolved.map(c =>
  c.descrizione ? `${c.codice} — ${c.descrizione}` : c.codice
);

// CTA, in ordine di affidabilita': il modulo di candidatura trovato sulla
// pagina ufficiale, poi la pagina ufficiale stessa, poi il portale pubblico.
// `link_bando` non e' nemmeno selezionato: era l'URL sull'aggregatore, e il
// ripiego su di lui ci mandava 94 CTA su 230 verso un sito terzo.
const cta = partecipabile
  ? sceltaCta({
      link: linkBando,
      fonteUfficiale,
      candidaturaEstratta: bando.link_candidatura_source === 'extracted' ? bando.link_candidatura : null,
    })
  : null;

// Decisione di resa (25/09/2026): anche un bando chiuso non mostra la CTA ne' il
// conto alla rovescia, come un sospeso o un revocato. `partecipazioneAperta` e il
// calcolo di `cta` restano com'erano: il chiuso si esclude solo qui.
const candidabile = partecipabile && stato !== 'chiuso';
const ctaVisibile = candidabile ? cta : null;
// Il conto alla rovescia solo per un aperto: su un «in apertura» farebbe credere
// che lo sia gia'. Mai «scaduto da N giorni».
const giorniMancanti = stato === 'aperto' ? testoGiorniMancanti(daysToDeadline) : null;
const oraScadenza = oraItaliana(campoTesto('ora_scadenza'));
const messaggioPartecipazione = stato === 'sospeso'
  ? 'Al momento non è possibile presentare domanda.'
  : stato === 'revocato' || stato === 'chiuso'
    ? 'Non è più possibile presentare domanda.'
    : ctaVisibile === null
      ? 'Non abbiamo ancora un link ufficiale verificato per la candidatura.'
      : null;

const mostraApertura = Boolean(bando.data_apertura) && stato === 'in apertura prossimamente';
// L'area si omette quando il nome dell'ente la contiene gia' («Regione Marche · Marche»).
const ente = bando.ente_erogatore?.trim() || null;
const area = bando.area_geografica?.trim() || null;
const sottotitolo = bando.titolo_breve && bando.titolo_breve.trim().toLowerCase() !== (bando.titolo ?? '').trim().toLowerCase()
  ? bando.titolo_breve
  : null;
const occhiello = [
  { testo: bando.tipologia_nome, href: hrefTipologia },
  { testo: bando.programma_nome, href: hrefProgramma },
].filter((v): v is { testo: string; href: string | null } => typeof v.testo === 'string' && v.testo !== '');

// Allegati: la stessa cintura di ogni altro URL in uscita. Si preferiscono le
// righe di `bando_link`, che hanno risposto 2xx all'ultimo controllo e portano
// la prova di essere state trovate nella pagina di riferimento; la colonna
// `bando.allegati` resta il ripiego per le schede che il resolver non ha ancora
// toccato.
const allegatiDaLink = linkBando
  .filter(l => l.tipo === 'allegato')
  .map(l => ({ url: l.url, label: l.etichetta ?? null, tipo: 'altro' }));
const allegati = soloPubblicabili(
  allegatiDaLink.length > 0 ? allegatiDaLink : bando.allegati,
  a => a?.url,
);

// Tipo allegato → etichetta del tag (PDF, DOC…); 'FILE' = tipo ignoto, il tag non si mostra
const allegatoTipoLabel = (tipo: string): string => {
  if (tipo === 'pdf') return 'PDF';
  if (tipo === 'doc' || tipo === 'docx') return 'DOC';
  if (tipo === 'xls' || tipo === 'xlsx' || tipo === 'ods') return 'XLS';
  if (tipo === 'odt' || tipo === 'rtf') return 'TXT';
  if (tipo === 'zip') return 'ZIP';
  return 'FILE';
};

// Gli allegati letti da `bando_link` arrivano tutti con tipo 'altro': il tipo si
// ricava dall'estensione dell'URL e, se resta ignoto, il tag non si mostra (un
// «FILE» su ogni riga non dice niente). Senza etichetta vale il nome del file.
const ESTENSIONE_ALLEGATO = /\.(pdf|docx?|xlsx?|ods|odt|rtf|zip)(?:[?#]|$)/i;
const nomeFile = (url: string): string | null => {
  try {
    const ultimo = new URL(url).pathname.split('/').filter(Boolean).pop();
    return ultimo ? decodeURIComponent(ultimo) : null;
  } catch {
    return null;
  }
};
const vociAllegati = allegati.map((a, i) => {
  const dichiarato = typeof a.tipo === 'string' ? a.tipo.toLowerCase() : '';
  const tipo = dichiarato !== '' && dichiarato !== 'altro'
    ? dichiarato
    : (ESTENSIONE_ALLEGATO.exec(a.url)?.[1]?.toLowerCase() ?? '');
  const tag = allegatoTipoLabel(tipo);
  return {
    url: a.url,
    tag: tag === 'FILE' ? null : tag,
    etichetta: (typeof a.label === 'string' ? a.label.trim() : '') || nomeFile(a.url) || `Documento ${i + 1}`,
  };
});

// Indice «In questa pagina»: gli id li assegna renderSezioni agli H2 e qui si
// leggono dall'HTML gia' reso, cosi' l'algoritmo degli id esiste in un posto
// solo. Il testo catturato e' gia' passato da `scappa`: si rende con set:html.
const SOGLIA_INDICE = 4;
const vociIndice = [...corpoHtml.matchAll(/<h2 id="([^"]+)"[^>]*>([^<]*)<\/h2>/g)]
  .map((m) => ({ id: m[1], testo: m[2] }))
  .filter((v) => v.testo.trim() !== '');
const conIndice = vociIndice.length >= SOGLIA_INDICE;

// Importi a video nel formato del mock (`eur`: punto delle migliaia anche sotto 10.000,
// «6.500 €»); formatImporto resta per la meta description.
const importoTotale = bando.importo_totale_eur != null ? eur(bando.importo_totale_eur) : null;
const importoMassimo = bando.importo_max_per_progetto_eur != null ? eur(bando.importo_max_per_progetto_eur) : null;
const beneficiari = bando.beneficiari_nomi.filter((b) => b.trim() !== '');
const tematiche = (bando.tematica ?? []).filter((t) => typeof t === 'string' && t.trim() !== '');
const ATECO_VISIBILI = 5;
const conSintesi = beneficiari.length > 0 || tematiche.length > 0 || Boolean(bando.programma_nome)
  || Boolean(bando.modalita_nome) || codiciAteco.length > 0 || Boolean(bando.data_pubblicazione);

// v4: meta_title/meta_description NON sono piu' colonne. Li derivo da titolo/descrizione_breve.
const titoloDisplay = bando.titolo || 'Bando';
const canonicalUrl = `https://edunews24.it/bandi/${bando.slug}`;

// Troncamento a confine di PAROLA, non all'ultimo punto (truncateAtDot):
// titoli e testi dei bandi sono pieni di abbreviazioni puntate (D.M., n.,
// S.p.A.) e importi con punti delle migliaia, che un taglio "al punto"
// mutilerebbe ("Decreto Ministeriale n.", "Dotazione 1.000.").
const truncateAtWord = (text: string, maxLen: number): string => {
  if (text.length <= maxLen) return text;
  const sub = text.slice(0, maxLen - 1);
  const lastSpace = sub.lastIndexOf(' ');
  return (lastSpace > 0 ? sub.slice(0, lastSpace) : sub).replace(/[\s,;:.]+$/, '') + '…';
};

// Title col brand quando rientra nel budget (budget 70 come le pagine articolo).
const titleSuffix = ' - EduNews24';
const metaTitle = titoloDisplay.length + titleSuffix.length <= 70
  ? titoloDisplay + titleSuffix
  : truncateAtWord(titoloDisplay, 70);

// Description mai vuota: descrizione_breve, altrimenti composta dai campi
// presenti (aggiungendo ogni frase SOLO se ci sta intera, per non spezzare
// date o importi), altrimenti default di sezione.
const metaDescription = (() => {
  if (bando.descrizione_breve) return truncateAtWord(bando.descrizione_breve, 155);
  const parts: string[] = [];
  if (bando.data_scadenza) parts.push(`Scadenza ${formatDate(bando.data_scadenza)}.`);
  if (bando.importo_totale_eur != null) parts.push(`Dotazione ${formatImporto(bando.importo_totale_eur)}.`);
  parts.push('Requisiti e candidatura su EduNews24.');
  let desc = truncateAtWord(
    bando.ente_erogatore ? `${titoloDisplay}: bando di ${bando.ente_erogatore}.` : `${titoloDisplay}.`,
    155,
  );
  for (const part of parts) {
    if (desc.length + 1 + part.length <= 155) desc += ` ${part}`;
  }
  return desc;
})();

// JSON-LD dal builder (src/lib/bandi/jsonld.ts): Article + about:MonetaryGrant,
// `sameAs` solo con una fonte ufficiale trovata — in F1 quindi mai — e nessun
// FAQPage. Prima `sameAs` valeva `link_bando`, cioe' l'aggregatore.
const jsonLd = jsonLdBando({
  urlCanonico: canonicalUrl,
  titolo: titoloDisplay,
  titoloBreve: bando.titolo_breve,
  descrizione: bando.descrizione_breve,
  dataPubblicazione: bando.data_pubblicazione,
  dataModifica: bando.updated_at ? new Date(bando.updated_at).toISOString() : null,
  enteErogatore: bando.ente_erogatore,
  areaGeografica: bando.area_geografica,
  beneficiari: bando.beneficiari_nomi,
  tematiche: bando.tematica,
  importoTotaleEur: bando.importo_totale_eur,
  // `sameAs` esce solo con una fonte `trovata`: prima era `link_bando`, cioe'
  // l'URL sull'aggregatore, e diceva a Google che la pagina ufficiale del
  // bando era su un sito terzo.
  fonteUfficiale,
});

const breadcrumbStructuredData = generateBreadcrumbStructuredData({
  category: 'Bandi',
  category_slug: 'bandi',
  slug: bando.slug,
  title: titoloDisplay,
});

// --- Design «Bandi Redesign»: valori derivati per il template ---------------

// Pillola dei giorni e colori «urgente»: aperto con scadenza entro 15 giorni.
const paletteScadenza = inScadenza(stato, daysToDeadline) ? PALETTE_SCADENZA.urgente : PALETTE_SCADENZA.normale;
// Calendario e barra di avanzamento: dalla pubblicazione, o dall'apertura se
// manca (src/lib/bandi/calendario.ts). Senza date utili non ci sono.
const cal = calendario({
  stato,
  pubblicazione: bando.data_pubblicazione,
  apertura: bando.data_apertura,
  scadenza: bando.data_scadenza,
  oggi,
});
const TRASLAZIONE = { '0%': 'translate-x-0', '-50%': '-translate-x-1/2', '-100%': '-translate-x-full' } as const;
// La riga del pannello Partecipazione: «Scade il…», «Scaduto il…», o nessuna data.
const rigaPartecipazione = rigaScadenza(stato, bando.data_scadenza, oggi)?.testo ?? 'Scadenza non indicata';
// Sotto la CTA: dove porta. L'host e' quello dell'URL della CTA stessa.
const hostCta = (() => {
  if (!ctaVisibile) return null;
  try {
    return new URL(ctaVisibile.url).hostname.replace(/^www\./, '');
  } catch {
    return null;
  }
})();
const notaCta = hostCta
  ? `${ctaVisibile?.etichetta === 'Consulta il bando sul portale pubblico' ? 'Si apre il portale pubblico' : 'Si apre il sito ufficiale'}: ${hostCta}`
  : null;
// Pallino della riga fonte: verde con una fonte ufficiale trovata, arancio altrimenti.
const fonteTrovata = fonteUfficiale?.stato === 'trovata';
// Riga sotto il titolo: sottotitolo, ente e (se aggiunge qualcosa) l'area geografica.
const areaUtile = area && !(ente ?? '').toLowerCase().includes(area.toLowerCase()) ? area : null;
const rigaSotto = [
  sottotitolo ? { testo: sottotitolo, forte: false } : null,
  ente ? { testo: ente, forte: true } : null,
  areaUtile ? { testo: areaUtile, forte: false } : null,
].filter((v): v is { testo: string; forte: boolean } => v !== null);
// Colori delle tessere dei documenti, come nel mock (ZIP e i tipi senza colore in grigio).
const COLORE_ALLEGATO: Record<string, string> = {
  PDF: 'bg-[#fdecec] text-[#a61b1b]',
  DOC: 'bg-[#e8f0fb] text-[#0a3d7a]',
  XLS: 'bg-[#e2f4ea] text-[#0b6b45]',
};
const classiCella = 'px-[26px] py-[22px] border-t border-[#eef1f5] lg:flex-1 lg:border-l lg:border-t-0';
const classiNumero = 'font-heading text-[24px] font-bold leading-[1.05] tabular-nums text-[#0a2244] lg:text-[30px]';
---

<Layout
  title={metaTitle}
  description={metaDescription}
  canonicalUrl={canonicalUrl}
  image="https://edunews24.it/og-bandi.png"
  ogType="article"
  publishedTime={bando.data_pubblicazione || undefined}
  modifiedTime={bando.updated_at ? new Date(bando.updated_at).toISOString() : undefined}
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <script type="application/ld+json" set:html={breadcrumbStructuredData} />
  </Fragment>

  <main class="bg-white font-[Poppins,system-ui,sans-serif] text-[#1a2233] antialiased leading-[normal]">
    {/* Testata: dove siamo, cos'e', e i dati che rispondono a «e' aperto e fino
        a quando?» e «quanto vale?» prima di qualunque testo. */}
    <section class="border-b border-[#e3e7ee] bg-[#f4f6f9]">
      <div class="mx-auto max-w-[1200px] px-4 pb-8 pt-7 sm:px-8">
        <nav aria-label="Breadcrumb" class="flex min-w-0 items-center gap-2 text-[13px] text-[#5b6576]">
          <a href="/" class="flex-none text-[#5b6576] no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004e9c]">Home</a>
          <span aria-hidden="true" class="text-[#9aa3b2]">/</span>
          <a href="/bandi" class="flex-none text-[#5b6576] no-underline hover:text-[#004e9c] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004e9c]">Bandi</a>
          <span aria-hidden="true" class="text-[#9aa3b2]">/</span>
          <span aria-current="page" class="overflow-hidden text-ellipsis whitespace-nowrap text-[#1a2233]">{titoloDisplay}</span>
        </nav>

        {occhiello.length > 0 && (
          <div class="mt-[22px] flex flex-wrap gap-2">
            {occhiello.map((voce) => voce.href
              ? <a href={voce.href} class="max-w-full whitespace-nowrap rounded-full border border-[#c7d6ea] bg-white px-[11px] py-1 text-[12.5px] font-medium text-[#003d7a] no-underline hover:border-[#004e9c] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004e9c]">{voce.testo}</a>
              : <span class="max-w-full whitespace-nowrap rounded-full border border-[#c7d6ea] bg-white px-[11px] py-1 text-[12.5px] font-medium text-[#003d7a]">{voce.testo}</span>)}
          </div>
        )}
        <h1 class={`${occhiello.length > 0 ? 'mt-3.5' : 'mt-[22px]'} max-w-[900px] text-balance font-heading text-[32px] font-bold leading-[1.04] tracking-[-.015em] text-[#0a2244] sm:text-[40px] lg:text-[46px]`}>{titoloDisplay}</h1>
        {rigaSotto.length > 0 && (
          <div class="mt-3.5 flex flex-wrap items-center gap-x-3.5 gap-y-1.5 text-[15.5px] text-[#3d4657]">
            {rigaSotto.map((voce, i) => (
              <Fragment>
                {i > 0 && <span aria-hidden="true" class="h-1 w-1 flex-none rounded-full bg-[#9aa3b2]"></span>}
                <span class={`max-w-full flex-none ${voce.forte ? 'font-semibold text-[#0a2244]' : ''}`}>{voce.testo}</span>
              </Fragment>
            ))}
          </div>
        )}

        {/* Dati chiave e calendario. Nessun segnaposto: una voce senza dato non c'e'. */}
        <div class="mt-7 rounded-[20px] border border-[#e3e7ee] bg-white shadow-[0_18px_40px_-30px_rgba(10,34,68,.4)]">
          <dl class="grid grid-cols-2 lg:flex">
            <div class="col-span-2 min-w-0 px-[26px] py-[22px] lg:flex-[1.7]">
              <dt class="text-[12.5px] text-[#5b6576]">Stato</dt>
              <dd class="mt-2">
                {aspetto && (
                  <span class={`inline-flex items-center gap-2 whitespace-nowrap rounded-full py-[5px] pl-[11px] pr-[13px] text-[15px] font-semibold ${aspetto.pillola}`}>
                    <span class={`h-[9px] w-[9px] rounded-full ${aspetto.punto}`}></span><span class={aspetto.extraEtichetta}>{aspetto.etichetta}</span>
                  </span>
                )}
                {sottotesto && <p class="mt-2.5 max-w-[44ch] text-[13.5px] leading-[1.55] text-[#3d4657]">{sottotesto}</p>}
              </dd>
            </div>
            {mostraApertura && (
              <div class={classiCella}>
                <dt class="text-[12.5px] text-[#5b6576]">Apertura</dt>
                <dd class={`mt-2 ${classiNumero}`}>{formatDate(bando.data_apertura)}</dd>
              </div>
            )}
            {bando.data_scadenza && (
              <div class={classiCella}>
                <dt class="text-[12.5px] text-[#5b6576]">Scadenza</dt>
                <dd class="mt-2">
                  <span class={`block ${classiNumero}`}>{formatDate(bando.data_scadenza)}</span>
                  {oraScadenza && <span class="mt-1 block text-[13px] tabular-nums text-[#3d4657]">ore {oraScadenza}</span>}
                  {giorniMancanti && <span class={`mt-2.5 inline-block rounded-[7px] px-2.5 py-1 text-[13px] font-semibold ${paletteScadenza.pillolaGiorni}`}>{giorniMancanti}</span>}
                </dd>
              </div>
            )}
            {importoTotale && (
              <div class={classiCella}>
                <dt class="text-[12.5px] text-[#5b6576]">Dotazione totale</dt>
                <dd class={`mt-2 whitespace-nowrap ${classiNumero}`}>{importoTotale}</dd>
              </div>
            )}
            {importoMassimo && (
              <div class={classiCella}>
                <dt class="text-[12.5px] text-[#5b6576]">Massimo per progetto</dt>
                <dd class={`mt-2 whitespace-nowrap ${classiNumero}`}>{importoMassimo}</dd>
              </div>
            )}
          </dl>

          {cal && (
            <div class="border-t border-[#eef1f5] px-[26px] pb-[22px] pt-5">
              <div class="flex flex-wrap items-baseline justify-between gap-x-4">
                <span class="font-heading text-[16px] font-semibold text-[#0a2244]">Calendario</span>
                <span class="text-[13px] text-[#4b5565]">{cal.nota}</span>
              </div>
              <div class="relative mt-3.5 h-[22px]">
                <div class={`absolute top-0 flex flex-col items-start ${TRASLAZIONE[cal.oggiTx]}`} style={`left:${cal.oggiX}`}>
                  <span class="whitespace-nowrap rounded-[5px] bg-[#e07b00] px-2 py-0.5 text-[11.5px] font-semibold text-white">{cal.oggiEtichetta}</span>
                </div>
              </div>
              <div class="relative h-5">
                {cal.sopra.map((m) => (
                  <span class={`absolute top-0 whitespace-nowrap text-[12px] text-[#3d4657] ${TRASLAZIONE[m.tx]}`} style={`left:${m.x}`}><strong class="font-semibold text-[#0a2244]">{m.etichetta}</strong> {m.data}</span>
                ))}
              </div>
              <div aria-hidden="true" class="relative mt-1 h-2.5 rounded-[5px] bg-[#e6eaf0]">
                <div class="absolute bottom-0 left-0 top-0 rounded-[5px] bg-[#004e9c]" style={`width:${cal.oggiX}`}></div>
                <span class="absolute -top-1.5 h-[22px] w-[3px] -translate-x-1/2 rounded-sm bg-[#e07b00]" style={`left:${cal.oggiX}`}></span>
                {cal.punti.map((x) => (
                  <span class="absolute top-1/2 h-3.5 w-3.5 -translate-x-1/2 -translate-y-1/2 rounded-full border-[3px] border-[#0a2244] bg-white" style={`left:${x}`}></span>
                ))}
              </div>
              <div class="relative mt-2 h-5">
                {cal.sotto.map((m) => (
                  <span class={`absolute top-0 whitespace-nowrap text-[12px] text-[#3d4657] ${TRASLAZIONE[m.tx]}`} style={`left:${m.x}`}><strong class="font-semibold text-[#0a2244]">{m.etichetta}</strong> {m.data}</span>
                ))}
              </div>
            </div>
          )}
        </div>

        <p class="mt-3.5 flex items-center gap-2 text-[12.5px] text-[#4b5565]"><span aria-hidden="true" class={`h-2 w-2 flex-none rounded-full ${fonteTrovata ? 'bg-[#12a36a]' : 'bg-[#e07b00]'}`}></span>{rigaFonte}</p>
      </div>
    </section>

    <div class="mx-auto max-w-[1200px] px-4 pb-[72px] pt-9 sm:px-8">
      {/* Aggiornamenti: gli eventi datati che la fonte ufficiale ha pubblicato
          dopo la nostra scheda. La frase e' templata dal tipo dell'evento, il
          link punta alla pagina che lo prova. Sta subito sotto i dati chiave:
          una proroga cambia la scadenza mostrata sopra. */}
      {aggiornamenti.length > 0 && (
        <section aria-labelledby="scheda_aggiornamenti" class="mb-10 grid grid-cols-1 gap-5 rounded-2xl border border-[#f1d7a6] bg-[#fff8ec] px-[22px] py-[18px] md:grid-cols-[180px_minmax(0,1fr)]">
          <div>
            <h2 id="scheda_aggiornamenti" class="font-heading text-[19px] font-semibold text-[#5a3300]">Aggiornamenti</h2>
            <p class="mt-1 text-[12.5px] text-[#8a4b00]">{aggiornamenti.length === 1 ? '1 novità dalla fonte' : `${aggiornamenti.length} novità dalla fonte`}</p>
          </div>
          <div>
            <ul class="flex flex-col">
              {aggiornamenti.map((voce) => (
                <li class="grid grid-cols-1 gap-x-3 border-b border-[#f3e2c2] py-2 text-[14px] leading-[1.5] sm:grid-cols-[140px_minmax(0,1fr)]">
                  <span class="tabular-nums text-[#8a4b00]">{voce.quando ?? ''}</span>
                  <span class="text-[#1a2233]"><strong class="font-semibold">{voce.testo}</strong>{voce.url && voce.host && (
                    <Fragment>{' · '}<a
                        href={voce.url}
                        target="_blank"
                        rel="noopener noreferrer nofollow"
                        class="break-words text-[#004e9c] underline underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004e9c]"
                      >{voce.host}<span class="sr-only"> (si apre in una nuova scheda)</span></a></Fragment>
                  )}</span>
                </li>
              ))}
            </ul>
            <p class="mt-2.5 text-[12.5px] text-[#8a4b00]">Le date nel testo sono quelle rilevate alla pubblicazione: fanno fede i dati qui sopra e questi aggiornamenti.</p>
          </div>
        </section>
      )}

      {/* Griglia: nel DOM la colonna azione viene prima dell'articolo, cosi' su
          mobile partecipazione e BandoFit arrivano prima del testo e nessun
          blocco e' duplicato; su desktop la colonna va a destra ed e' sticky. */}
      <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-16">
        <div class="flex flex-col gap-4 lg:sticky lg:top-5 lg:col-start-2 lg:row-start-1">
          {/* Partecipazione: una sola CTA, e solo se la destinazione e'
              affidabile. Nessun bottone e' meglio di un bottone che porta a un
              aggregatore. */}
          <section aria-labelledby="scheda_partecipazione" class="rounded-[20px] border border-[#e3e7ee] bg-white p-[22px] shadow-[0_18px_40px_-30px_rgba(10,34,68,.45)]">
            <h2 id="scheda_partecipazione" class="font-heading text-[18px] font-semibold text-[#0a2244]">Partecipazione</h2>
            <div class="mt-3 flex flex-wrap items-center gap-2">
              {aspetto && (
                <span class={`inline-flex flex-none items-center gap-1.5 whitespace-nowrap rounded-full py-[3px] pl-2 pr-[9px] text-[12px] font-semibold ${aspetto.pillola}`}>
                  <span class={`h-[7px] w-[7px] rounded-full ${aspetto.punto}`}></span><span class={aspetto.extraEtichetta}>{aspetto.etichetta}</span>
                </span>
              )}
              <span class="text-[13.5px] text-[#3d4657]">{rigaPartecipazione}</span>
            </div>
            {giorniMancanti && daysToDeadline !== null && (
              <div class="mt-4">
                <div class="flex items-baseline gap-2">
                  <span class="font-heading text-[40px] font-bold leading-none tabular-nums text-[#0a2244]">{daysToDeadline}</span>
                  <span class="text-[14px] text-[#3d4657]">{daysToDeadline === 1 ? 'giorno alla scadenza' : 'giorni alla scadenza'}</span>
                </div>
                {cal && (
                  <div aria-hidden="true" class="mt-2.5 h-1.5 overflow-hidden rounded-[3px] bg-[#e6eaf0]"><div class="h-full rounded-[3px] bg-[#004e9c]" style={`width:${cal.trascorso}`}></div></div>
                )}
              </div>
            )}
            {ctaVisibile && (
              <Fragment>
                <a
                  href={ctaVisibile.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="mt-[18px] flex min-h-[54px] items-center justify-center gap-2.5 rounded-xl bg-[#004e9c] px-[18px] py-3 text-center text-[15.5px] font-semibold leading-[1.3] text-white no-underline hover:bg-[#003d7a] hover:text-white focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004e9c]"
                >{ctaVisibile.etichetta}<svg aria-hidden="true" focusable="false" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24" class="flex-none"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg><span class="sr-only"> (si apre in una nuova scheda)</span></a>
                {notaCta && <p class="mt-2.5 text-center text-[12.5px] text-[#5b6576]">{notaCta}</p>}
              </Fragment>
            )}
            {messaggioPartecipazione && (
              <p class="mt-4 text-[13.5px] leading-[1.55] text-[#3d4657]">{messaggioPartecipazione}</p>
            )}
            {!candidabile && (hrefProgramma || hrefTipologia) && (
              <ul class="mt-2 flex flex-col text-[13.5px]">
                {hrefProgramma && (
                  <li><a href={hrefProgramma} class="inline-flex min-h-11 items-center text-[#004e9c] underline underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004e9c]">Bandi dello stesso programma: {bando.programma_nome}</a></li>
                )}
                {hrefTipologia && (
                  <li><a href={hrefTipologia} class="inline-flex min-h-11 items-center text-[#004e9c] underline underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004e9c]">Bandi della stessa tipologia: {bando.tipologia_nome}</a></li>
                )}
              </ul>
            )}
          </section>

          <BandiExpertCta variante="scheda" utmContent="dettaglio-sidebar" candidabile={candidabile} />

          <a href="/bandi" class="flex items-center gap-2 px-0.5 py-1 text-[13.5px] font-medium text-[#004e9c] no-underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004e9c]"><svg aria-hidden="true" focusable="false" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 12H5M11 6l-6 6 6 6"></path></svg>Torna all'elenco dei bandi</a>
        </div>

        <article class="min-w-0 max-w-[700px] lg:col-start-1 lg:row-start-1">
          {/* Titolo nascosto: senza, lead e corpo finirebbero sotto «Partecipazione»
              nella struttura dei titoli e nel Markdown per agenti. */}
          {(bando.descrizione_breve || avvisoCorpo || corpoHtml) && (
            <h2 id="scheda_descrizione" class="sr-only">Descrizione del bando</h2>
          )}
          {bando.descrizione_breve && (
            <p class="text-pretty text-[20px] leading-[1.6] text-[#1a2233]">{bando.descrizione_breve}</p>
          )}
          {avvisoCorpo && (
            <p class={`${bando.descrizione_breve ? 'mt-6' : ''} rounded-xl border border-[#e3e7ee] bg-[#f7f9fb] px-4 py-3 text-[14px] leading-[1.55] text-[#4b5565]`}>{avvisoCorpo}</p>
          )}

          {/* In sintesi: un solo elenco di definizioni, due colonne come nel mock. */}
          {conSintesi && (
            <section aria-labelledby="scheda_sintesi" class={`${bando.descrizione_breve || avvisoCorpo ? 'mt-8' : ''} overflow-hidden rounded-2xl border border-[#e3e7ee]`}>
              <h2 id="scheda_sintesi" class="border-b border-[#e3e7ee] bg-[#f7f9fb] px-5 py-3.5 font-heading text-[16px] font-semibold text-[#0a2244]">In sintesi</h2>
              <dl class="grid grid-cols-1 sm:grid-cols-2">
                {beneficiari.length > 0 && (
                  <div class="border-b border-r border-[#eef1f5] px-5 py-3.5">
                    <dt class="text-[12.5px] text-[#5b6576]">A chi si rivolge</dt>
                    <dd class="mt-1 text-[14.5px] font-medium leading-[1.45] text-[#1a2233]">{beneficiari.join(', ')}</dd>
                  </div>
                )}
                {tematiche.length > 0 && (
                  <div class="border-b border-r border-[#eef1f5] px-5 py-3.5">
                    <dt class="text-[12.5px] text-[#5b6576]">Tematica</dt>
                    <dd class="mt-1 text-[14.5px] font-medium leading-[1.45] text-[#1a2233]">{tematiche.join(', ')}</dd>
                  </div>
                )}
                {bando.programma_nome && (
                  <div class="border-b border-r border-[#eef1f5] px-5 py-3.5">
                    <dt class="text-[12.5px] text-[#5b6576]">Programma</dt>
                    <dd class="mt-1 text-[14.5px] font-medium leading-[1.45]">
                      {hrefProgramma
                        ? <a href={hrefProgramma} class="text-[#004e9c] underline underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004e9c]">{bando.programma_nome}</a>
                        : <span class="text-[#1a2233]">{bando.programma_nome}</span>}
                    </dd>
                  </div>
                )}
                {bando.modalita_nome && (
                  <div class="border-b border-r border-[#eef1f5] px-5 py-3.5">
                    <dt class="text-[12.5px] text-[#5b6576]">Modalità di erogazione</dt>
                    <dd class="mt-1 text-[14.5px] font-medium leading-[1.45] text-[#1a2233]">{bando.modalita_nome}</dd>
                  </div>
                )}
                {codiciAteco.length > 0 && (
                  <div class="border-b border-r border-[#eef1f5] px-5 py-3.5">
                    <dt class="text-[12.5px] text-[#5b6576]">Codici ATECO</dt>
                    <dd class="mt-1 text-[14.5px] font-medium leading-[1.45] text-[#1a2233]">
                      <ul class="flex flex-col gap-1 tabular-nums">
                        {codiciAteco.slice(0, ATECO_VISIBILI).map((c) => <li>{c}</li>)}
                      </ul>
                      {codiciAteco.length > ATECO_VISIBILI && (
                        <details class="mt-1">
                          <summary class="inline-flex min-h-11 cursor-pointer list-none items-center text-[13.5px] font-medium text-[#004e9c] underline underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004e9c] [&::-webkit-details-marker]:hidden">Mostra tutti ({codiciAteco.length})</summary>
                          <ul class="flex flex-col gap-1 tabular-nums">
                            {codiciAteco.slice(ATECO_VISIBILI).map((c) => <li>{c}</li>)}
                          </ul>
                        </details>
                      )}
                    </dd>
                  </div>
                )}
                {bando.data_pubblicazione && (
                  <div class="border-b border-r border-[#eef1f5] px-5 py-3.5">
                    <dt class="text-[12.5px] text-[#5b6576]">Data di pubblicazione</dt>
                    <dd class="mt-1 text-[14.5px] font-medium leading-[1.45] tabular-nums text-[#1a2233]">{formatDate(bando.data_pubblicazione)}</dd>
                  </div>
                )}
              </dl>
            </section>
          )}

          {conIndice && (
            <nav aria-labelledby="scheda_indice" class="mt-8 border-l-2 border-[#e3e7ee] pl-4">
              <p id="scheda_indice" class="text-[13px] font-semibold text-[#0a2244]">In questa pagina</p>
              <ul class="mt-1">
                {vociIndice.map((voce) => (
                  <li><a href={`#${voce.id}`} class="block py-1.5 text-[14px] text-[#004e9c] underline underline-offset-2 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004e9c]" set:html={voce.testo} /></li>
                ))}
              </ul>
            </nav>
          )}

          {corpoHtml && (
            <div class="mt-9 text-[16px] leading-[1.75] text-[#2b3342] [counter-reset:sezione] [&_li]:pl-1 [&_strong]:text-[#0a2244]" set:html={corpoHtml} />
          )}

          {/* Documenti e allegati: la tessera dice il tipo di file. */}
          {vociAllegati.length > 0 && (
            <section aria-labelledby="scheda_allegati" class="mt-12">
              <h2 id="scheda_allegati" class="mb-3 font-heading text-[22px] font-bold text-[#0a2244]">Documenti e allegati</h2>
              <ul class="flex flex-col gap-2">
                {vociAllegati.map((a) => (
                  <li>
                    <a
                      href={a.url}
                      target="_blank"
                      rel="noopener noreferrer nofollow"
                      class="flex items-center gap-3.5 rounded-xl border border-[#e3e7ee] px-4 py-3.5 text-[#1a2233] no-underline hover:border-[#9fb3d1] hover:bg-[#f9fbfd] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004e9c]"
                    >
                      <span aria-hidden="true" class={`flex h-[42px] w-[42px] flex-none items-center justify-center rounded-[9px] text-[11px] font-bold tracking-[.02em] ${(a.tag && COLORE_ALLEGATO[a.tag]) || 'bg-[#eef1f5] text-[#3d4657]'}`}>
                        {a.tag ?? <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 3h7l5 5v13H7zM14 3v5h5"></path></svg>}
                      </span>
                      <span class="min-w-0 flex-1 break-words text-[14.5px] leading-[1.45]">{a.etichetta}{a.tag && <span class="sr-only"> ({a.tag})</span>}<span class="sr-only"> (si apre in una nuova scheda)</span></span>
                      <svg aria-hidden="true" focusable="false" width="18" height="18" fill="none" stroke="#5b6576" viewBox="0 0 24 24" class="flex-none"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </article>
      </div>
    </div>
  </main>
</Layout>
