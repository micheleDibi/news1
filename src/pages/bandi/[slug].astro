---
import Layout from '../../layouts/Layout.astro';
import BandoContenuto from '../../components/bandi/BandoContenuto.astro';
import BandoSidebar from '../../components/bandi/BandoSidebar.astro';
import BandiExpertCta from '../../components/BandiExpertCta.astro';
import {
  supabaseBandi, loadCatalogo, resolveBandoRelations,
  BANDO_SELECT_DETAIL, computeScadenzaStato,
  type Bando, type BandoDetail,
} from '../../lib/supabase-bandi';
import { format } from 'date-fns';
import { it } from 'date-fns/locale';

export const prerender = false;

const { slug } = Astro.params;
const host = Astro.url.origin;

if (!slug) {
  return new Response('Slug mancante', { status: 400 });
}

const { data, error } = await supabaseBandi
  .from('bando')
  .select(BANDO_SELECT_DETAIL)
  .eq('slug', slug)
  .maybeSingle();

if (error || !data) {
  Astro.response.status = 404;
}

const bando = data as Bando | null;
const catalogo = bando ? await loadCatalogo() : null;
const bandoDetail: BandoDetail | null = bando && catalogo
  ? await resolveBandoRelations(bando, catalogo)
  : null;

const publicUrl = `${host}/bandi/${slug}`;
const ogImage = `${host}/og/bandi/${slug}.svg`;
const titoloDisplay = bando?.titolo ?? bando?.titolo_raw ?? 'Bando senza titolo';
const descrShort = bando?.descrizione_breve ?? '';
const metaTitle = titoloDisplay.length > 60 ? titoloDisplay.slice(0, 57) + '...' : titoloDisplay;
const metaDescription = descrShort.length > 155 ? descrShort.slice(0, 152) + '...' : descrShort;

const scadenzaDisplay = bando?.data_scadenza
  ? format(new Date(bando.data_scadenza), 'd MMMM yyyy', { locale: it })
  : null;
const pubblicazioneDisplay = bando?.data_pubblicazione
  ? format(new Date(bando.data_pubblicazione), 'd MMMM yyyy', { locale: it })
  : null;
const scadenzaStato = bando ? computeScadenzaStato(bando.data_scadenza) : null;

// JSON-LD
let jsonLd: any = null;
if (bandoDetail) {
  jsonLd = {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: titoloDisplay,
    description: metaDescription || undefined,
    datePublished: bandoDetail.data_pubblicazione ?? undefined,
    dateModified: bandoDetail.updated_at ?? undefined,
    author: { '@type': 'Organization', name: 'EduNews24', url: 'https://edunews24.it' },
    publisher: {
      '@type': 'Organization',
      name: 'EduNews24',
      logo: { '@type': 'ImageObject', url: 'https://edunews24.it/logo.png' },
    },
    image: ogImage,
    mainEntityOfPage: publicUrl,
    about: {
      '@type': 'GovernmentService',
      name: titoloDisplay,
      serviceType: bandoDetail.tipologia_nome ?? undefined,
      provider: bandoDetail.ente_erogatore
        ? { '@type': 'GovernmentOrganization', name: bandoDetail.ente_erogatore }
        : undefined,
      areaServed: bandoDetail.area_geografica
        ? { '@type': 'AdministrativeArea', name: bandoDetail.area_geografica }
        : undefined,
    },
  };
}
---

{!bando && (
  <Layout title="Bando non trovato - EduNews24" description="Il bando richiesto non è disponibile." robots="noindex,nofollow">
    <main class="bg-slate-50 min-h-screen flex items-center justify-center px-4 py-12">
      <div class="max-w-md text-center">
        <h1 class="text-2xl font-bold text-slate-900 mb-3">Bando non trovato</h1>
        <p class="text-slate-600 mb-6">
          Il bando che stai cercando non è disponibile o è stato rimosso. Potrebbe non essere
          ancora stato pubblicato oppure non superare i nostri criteri di validazione.
        </p>
        <a href="/bandi" class="inline-block bg-blue-600 text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-blue-700 transition">
          Torna alla lista bandi
        </a>
      </div>
    </main>
  </Layout>
)}

{bando && bandoDetail && (
  <Layout
    title={`${metaTitle} - EduNews24`}
    description={metaDescription}
    canonicalUrl={publicUrl}
    image={ogImage}
    ogType="article"
    publishedTime={bandoDetail.data_pubblicazione ?? undefined}
    modifiedTime={bandoDetail.updated_at ?? undefined}
  >
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}

    <main class="bg-slate-50 min-h-screen">
      <article class="max-w-6xl mx-auto px-4 py-8">
        <nav class="text-sm text-slate-600 mb-4" aria-label="Breadcrumb">
          <a href="/" class="hover:underline">Home</a>
          <span class="mx-1.5">›</span>
          <a href="/bandi" class="hover:underline">Bandi</a>
          <span class="mx-1.5">›</span>
          <span class="text-slate-800">{bandoDetail.titolo_breve ?? 'Dettaglio'}</span>
        </nav>

        <header class="mb-6">
          {bandoDetail.titolo_breve && (
            <p class="text-sm uppercase tracking-wider text-blue-700 font-semibold mb-2">
              {bandoDetail.titolo_breve}
            </p>
          )}
          <h1 class="text-3xl md:text-4xl font-bold text-slate-900 leading-tight mb-3">
            {titoloDisplay}
          </h1>
          {bandoDetail.descrizione_breve && (
            <p class="text-lg text-slate-700 max-w-3xl">{bandoDetail.descrizione_breve}</p>
          )}

          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2 text-sm text-slate-600">
            {bandoDetail.ente_erogatore && (
              <span>
                <span class="text-slate-500">Ente:</span>{' '}
                <strong class="text-slate-900">{bandoDetail.ente_erogatore}</strong>
              </span>
            )}
            {scadenzaDisplay && (
              <span class={scadenzaStato === 'scaduto' ? 'text-slate-500 line-through' : ''}>
                <span class="text-slate-500">Scadenza:</span>{' '}
                <strong class={scadenzaStato === 'scaduto' ? 'text-slate-500' : 'text-slate-900'}>{scadenzaDisplay}</strong>
              </span>
            )}
            {pubblicazioneDisplay && (
              <span>
                <span class="text-slate-500">Pubblicato:</span>{' '}
                <strong class="text-slate-900">{pubblicazioneDisplay}</strong>
              </span>
            )}
          </div>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-8">
          <div>
            <BandoContenuto contenuto={bandoDetail.contenuto} descrizioneBreve={bandoDetail.descrizione_breve} />
          </div>
          <BandoSidebar bando={bandoDetail} publicUrl={publicUrl} />
        </div>

        <div class="mt-10">
          <BandiExpertCta variant="full" />
        </div>
      </article>
    </main>
  </Layout>
)}
