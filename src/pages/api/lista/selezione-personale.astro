---
/**
 * Frammento HTML della lista di selezione personale, reso con gli stessi componenti
 * della pagina. Vedi src/pages/api/lista/interpelli.astro per il perche'.
 */
export const prerender = false;

import ListaSelezione from '../../../components/liste/ListaSelezione.astro';
import PaginazioneLinks from '../../../components/filtro/PaginazioneLinks.astro';
import { DEF_SELEZIONE, caricaListaSelezione } from '../../../lib/liste/selezione-personale';
import { leggiFiltri, filtriAttivi, urlLista } from '../../../lib/liste/parametri';
import { numeroPagine } from '../../../lib/paginazione';

Astro.response.headers.set('X-Robots-Tag', 'noindex');
Astro.response.headers.set('Cache-Control', 'no-store');

const valori = leggiFiltri(Astro.url, DEF_SELEZIONE);
const grezzo = Astro.url.searchParams.get('page');
const pagina = /^[1-9]\d{0,5}$/.test(grezzo ?? '1') ? Number(grezzo ?? '1') : 1;

const { righe, totale } = await caricaListaSelezione(valori, pagina);
const pagine = numeroPagine(totale, DEF_SELEZIONE.perPagina);
const base = urlLista(DEF_SELEZIONE, valori, 1);
---
<div id="frammento" data-totale={totale} data-pagina={pagina} data-pagine={pagine}>
  <ListaSelezione righe={righe} filtrata={filtriAttivi(valori) > 0} />
  <PaginazioneLinks base={base} pagina={pagina} pagine={pagine} accento="giallo" />
</div>
