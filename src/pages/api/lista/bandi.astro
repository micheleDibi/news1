---
/**
 * Frammento HTML della lista bandi, reso con gli stessi componenti della pagina.
 * Vedi src/pages/api/lista/interpelli.astro per il perche'.
 */
export const prerender = false;

import ListaBandi from '../../../components/liste/ListaBandi.astro';
import PaginazioneLinks from '../../../components/filtro/PaginazioneLinks.astro';
import { DEF_BANDI, caricaBandi } from '../../../lib/liste/bandi';
import { leggiFiltri, filtriAttivi, urlLista } from '../../../lib/liste/parametri';
import { numeroPagine } from '../../../lib/paginazione';

Astro.response.headers.set('X-Robots-Tag', 'noindex');
Astro.response.headers.set('Cache-Control', 'no-store');

const valori = leggiFiltri(Astro.url, DEF_BANDI);
const grezzo = Astro.url.searchParams.get('page');
const pagina = /^[1-9]\d{0,5}$/.test(grezzo ?? '1') ? Number(grezzo ?? '1') : 1;

const { righe, totale } = await caricaBandi(valori, pagina);
const pagine = numeroPagine(totale, DEF_BANDI.perPagina);
const base = urlLista(DEF_BANDI, valori, 1);
---
<div id="frammento" data-totale={totale} data-pagina={pagina} data-pagine={pagine}>
  <ListaBandi righe={righe} filtrata={filtriAttivi(valori) > 0} />
  <PaginazioneLinks base={base} pagina={pagina} pagine={pagine} accento="blu" />
</div>
