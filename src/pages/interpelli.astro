---
/**
 * Elenco degli interpelli.
 *
 * Lo stato della lista (filtri e pagina) vive nell'URL ed e' reso dal server: senza
 * JavaScript la pagina funziona lo stesso, e un crawler puo' raggiungere tutti gli
 * annunci seguendo i link di paginazione. Lo script client resta solo per evitare il
 * ricaricamento, e chiede al server lo stesso frammento HTML.
 */
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import ListaInterpelli from '../components/liste/ListaInterpelli.astro';
import PaginazioneLinks from '../components/filtro/PaginazioneLinks.astro';
import Sorelle from '../components/filtro/Sorelle.astro';
import { vociPubblicate, hrefFiltro, hrefHub, hubDisponibili } from '../lib/pagine-filtro';
import { slugInterpello, DEF_INTERPELLI, caricaInterpelli, opzioniFiltroInterpelli, type Interpello } from '../lib/liste/interpelli';
import {
  leggiFiltri, filtriAttivi, normalizzazioneRichiesta, dimensioneUnica, seoLista, urlLista,
} from '../lib/liste/parametri';
import { leggiPagina, numeroPagine, rispostaNonTrovata } from '../lib/paginazione';
import { generateBreadcrumbStructuredData, generateItemListStructuredData, generateFAQStructuredData } from '../lib/seo';
import IntroSezione from '../components/liste/IntroSezione.astro';
import FaqInterpelli from '../components/liste/FaqInterpelli.astro';
import { INTRO_INTERPELLI, FAQ_INTERPELLI } from '../lib/liste/testi';

const DEF = DEF_INTERPELLI;
const valori = leggiFiltri(Astro.url, DEF);
const pag = leggiPagina(Astro.url, DEF.base);
const pagina = pag.tipo === 'ok' ? pag.pagina : 1;

// `?page=1` e i parametri vuoti prodotti dal form (select su "Tutte") collassano
// sull'URL pulito con un 301. I parametri estranei (utm_*, fbclid) restano intatti.
const normalizzato = normalizzazioneRichiesta(Astro.url, DEF, valori, pagina);
if (normalizzato) return Astro.redirect(normalizzato, 301);
if (pag.tipo === 'redirect') return Astro.redirect(pag.href, 301);

// Una sola dimensione filtrata ha un equivalente indicizzabile: la pagina statica.
// 302 e non 301 perche' le soglie di pubblicazione sono ancora in taratura e un 301
// verso una pagina che scendesse sotto soglia resterebbe in cache.
const unica = dimensioneUnica(DEF, valori, pagina);
if (unica) {
  const pubblicate = await vociPubblicate(DEF.sezione, unica.dimensione);
  if (pubblicate.some((v) => v.slug === unica.slug)) {
    return Astro.redirect(hrefFiltro(DEF.sezione, unica.dimensione, unica.slug), 302);
  }
}

const { righe, totale } = await caricaInterpelli(valori, pagina);
const pagine = numeroPagine(totale, DEF.perPagina);

// Pagina oltre l'ultima: 404 reale, non un 200 con la lista vuota.
if (pagina > pagine || (righe.length === 0 && pagina > 1)) {
  return rispostaNonTrovata('Pagina non trovata', 'La pagina richiesta non esiste.', DEF.base, 'Torna agli interpelli');
}

const opzioni = await opzioniFiltroInterpelli();
const conFiltri = filtriAttivi(valori) > 0;
const { canonical, robots } = seoLista(DEF, valori, pagina);

// Title 62 caratteri, description 150: entrambi dentro cio' che Google mostra.
const pageTitle = pagina > 1
  ? `Interpelli scuola: pagina ${pagina} di ${pagine} - EduNews24`
  : 'Interpelli scuola: docenti, ATA e DSGA per regione - EduNews24';
const pageDescription = pagina > 1
  ? `Interpelli pubblicati dalle scuole italiane, pagina ${pagina} di ${pagine}: filtra per regione, provincia e classe di concorso.`
  : 'Consulta gli interpelli pubblicati dalle scuole italiane: filtra per regione, provincia e classe di concorso e apri il testo integrale di ogni avviso.';
const pageKeywords = 'interpelli scuola, lavoro scuola, supplenze, interpelli insegnanti, opportunità scuola, lavoro pubblico scuola';

// Blocchi "Esplora per ...": link alle pagine filtro pubblicate.
const blocchiEsplora: Array<{ titolo: string; voci: Array<{ etichetta: string; href: string; totale: number }>; hrefTutti: string }> = [];
for (const dimEsplora of hubDisponibili(DEF.sezione)) {
  const vociEsplora = await vociPubblicate(DEF.sezione, dimEsplora.slug);
  if (vociEsplora.length === 0) continue;
  blocchiEsplora.push({
    titolo: `Esplora per ${dimEsplora.etichetta.toLowerCase()}`,
    voci: vociEsplora.slice(0, 24).map((v) => ({ etichetta: v.etichetta, href: hrefFiltro(DEF.sezione, dimEsplora.slug, v.slug), totale: v.totale })),
    hrefTutti: hrefHub(DEF.sezione, dimEsplora.slug),
  });
}

const breadcrumbStructuredData = generateBreadcrumbStructuredData({
  category: 'Interpelli Scuola',
  category_slug: 'interpelli',
});
const itemListItems = righe
  .filter((i: Interpello) => i.article_title || i.interpello_name)
  .map((i: Interpello) => ({ href: `/interpelli/${slugInterpello(i)}`, title: i.article_title || i.interpello_name }));
const itemListStructuredData = itemListItems.length > 0
  ? generateItemListStructuredData(itemListItems, 'Interpelli Scuola', canonical, (pagina - 1) * DEF.perPagina + 1)
  : null;

const mostraIntro = pagina === 1 && !conFiltri;
const faqStructuredData = mostraIntro ? generateFAQStructuredData([...FAQ_INTERPELLI]) : null;

const hrefPrec = pagina > 2 ? urlLista(DEF, valori, pagina - 1) : pagina === 2 ? urlLista(DEF, valori, 1) : null;
const hrefSucc = pagina < pagine ? urlLista(DEF, valori, pagina + 1) : null;
const basePaginazione = urlLista(DEF, valori, 1);
const provinceCorrenti = valori.regione[0] ? (opzioni.provincePerRegione[valori.regione[0]] ?? []) : [];
---
<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} canonicalUrl={canonical} robots={robots}>
  <script type="application/ld+json" set:html={breadcrumbStructuredData} slot="head" />
  {itemListStructuredData && <script type="application/ld+json" set:html={itemListStructuredData} slot="head" />}
  {faqStructuredData && <script type="application/ld+json" set:html={faqStructuredData} slot="head" />}
  {hrefPrec && <link rel="prev" href={`https://edunews24.it${hrefPrec}`} slot="head" />}
  {hrefSucc && <link rel="next" href={`https://edunews24.it${hrefSucc}`} slot="head" />}

  <main class="bg-gray-50 min-h-screen">
    {/* Hero header */}
    <div class="bg-gradient-to-r from-red-700 to-red-800 text-white py-10 px-4 sm:px-6 lg:px-8">
      <div class="container mx-auto max-w-6xl">
        <nav class="flex text-sm text-red-200 mb-4" aria-label="Breadcrumb">
          <ol class="inline-flex items-center space-x-1">
            <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
            <li class="flex items-center">
              <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
              <span class="text-white font-medium">Interpelli Scuola</span>
            </li>
          </ol>
        </nav>
        <h1 class="text-3xl md:text-4xl font-bold mb-2">Interpelli Scuola</h1>
        <p class="text-red-100 text-lg max-w-2xl">Trova opportunità di lavoro nella scuola pubblica italiana, divise per regione, provincia e classe di concorso.</p>
        {pagina > 1 && <p class="text-red-100 text-sm mt-1">Pagina {pagina} di {pagine}</p>}
        <div class="mt-4 flex items-center gap-4 text-sm">
          <span class="inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm px-3 py-1.5 rounded-full">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <span id="hero-count">{totale}</span> interpelli disponibili
          </span>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 max-w-6xl -mt-6">
      {/* Filtri: form GET, funzionante anche senza JavaScript */}
      <form id="filtri" method="get" action="/interpelli" data-frammento="/api/lista/interpelli" data-lista="interpelli-list" class="mb-6 p-5 bg-white rounded-xl shadow-md border border-gray-100">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 items-end">
          <div class="lg:col-span-2">
            <label for="search-filter" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Cerca</label>
            <div class="relative">
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              <input type="search" id="search-filter" name="q" value={valori.q[0] ?? ''} placeholder="Nome interpello, descrizione..." class="w-full pl-10 pr-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm bg-gray-50 transition-colors">
            </div>
          </div>

          <div>
            <label for="regione-filter" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Regione</label>
            <select id="regione-filter" name="regione" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm bg-gray-50">
              <option value="">Tutte</option>
              {opzioni.regioni.map((r) => <option value={r.slug} selected={valori.regione[0] === r.slug}>{r.etichetta}</option>)}
            </select>
          </div>

          <div>
            <label for="provincia-filter" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Provincia</label>
            {/* Renderizzata dal server in base alla regione scelta: funziona senza JS. */}
            <select id="provincia-filter" name="provincia" disabled={provinceCorrenti.length === 0} class="w-full px-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm bg-gray-50">
              <option value="">Tutte</option>
              {provinceCorrenti.map((p) => <option value={p.slug} selected={valori.provincia[0] === p.slug}>{p.etichetta}</option>)}
            </select>
          </div>

          <div>
            <label for="classe-filter" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Classe Concorso</label>
            <select id="classe-filter" name="classe" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500 text-sm bg-gray-50">
              <option value="">Tutte</option>
              {opzioni.classi.map((c) => <option value={c.slug} selected={valori.classe[0] === c.slug}>{c.etichetta}</option>)}
            </select>
          </div>

          <div class="flex gap-2">
            <div class="flex-1">
              <label class="block text-xs font-semibold text-transparent mb-1.5">Filtra</label>
              <button type="submit" class="w-full px-4 py-2.5 border border-red-700 rounded-lg text-sm font-medium text-white bg-red-700 hover:bg-red-800 transition-colors">Filtra</button>
            </div>
            <div class="flex-1">
              <label class="block text-xs font-semibold text-transparent mb-1.5">Reset</label>
              <a id="reset-filters" href="/interpelli" class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm font-medium text-gray-600 bg-gray-50 hover:bg-gray-100 transition-colors flex items-center justify-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                Resetta
              </a>
            </div>
          </div>
        </div>
      </form>

      {/* Mappa regione -> province per il select dipendente. Prende il posto del
          define:vars, che serializzava anche URL e chiave anon di Supabase. */}
      <script type="application/json" id="dati-province" set:html={JSON.stringify(opzioni.provincePerRegione)} is:inline></script>

      <div class="mb-4 flex items-center justify-between">
        <p id="results-count" class="text-sm text-gray-500">
          <span id="visible-count" class="font-semibold text-gray-700">{totale}</span> interpelli trovati
        </p>
        <div id="loading-indicator" class="hidden items-center gap-2 text-sm text-red-600">
          <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
          Caricamento...
        </div>
      </div>
      <p id="stato-risultati" class="sr-only" aria-live="polite"></p>

      <ListaInterpelli righe={righe} filtrata={conFiltri} />

      <PaginazioneLinks base={basePaginazione} pagina={pagina} pagine={pagine} accento="rosso" />

      <IntroSezione intro={INTRO_INTERPELLI} completa={mostraIntro} />

      {mostraIntro && <FaqInterpelli />}

      {/* Linking interno verso le pagine filtro. Sta DENTRO <main> (il middleware, per
          la negoziazione Markdown, estrae solo quel nodo) e FUORI dal contenitore della
          lista, che lo script client sostituisce a ogni filtro. */}
      {blocchiEsplora.map((b) => (
        <Sorelle titolo={b.titolo} voci={b.voci} hrefTutti={b.hrefTutti} />
      ))}
    </div>
  </main>
</Layout>

<script>
  import { attivaLista, attivaProvinceDipendenti } from '../scripts/lista';
  attivaProvinceDipendenti();
  attivaLista({ idLista: 'interpelli-list' });
</script>
