---
/**
 * Elenco dei bandi di finanziamento.
 *
 * Lo stato della lista (tredici filtri e pagina) vive nell'URL ed e' reso dal server:
 * senza JavaScript la pagina funziona lo stesso e un crawler raggiunge tutti i bandi
 * seguendo i link di paginazione. Lo script client serve solo a evitare il
 * ricaricamento e chiede al server lo stesso frammento HTML.
 */
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import ListaBandi from '../components/liste/ListaBandi.astro';
import PaginazioneLinks from '../components/filtro/PaginazioneLinks.astro';
import Sorelle from '../components/filtro/Sorelle.astro';
import BandiExpertCta from '../components/BandiExpertCta.astro';
import { bandofitCtaUrl } from '../lib/bandofit';
import { vociPubblicate, hrefFiltro, hrefHub, hubDisponibili } from '../lib/pagine-filtro';
import { DEF_BANDI, caricaBandi, opzioniFiltroBandi, dimensioneUnicaBandi, MULTISELECT } from '../lib/liste/bandi';
import { leggiFiltri, filtriAttivi, normalizzazioneRichiesta, seoLista, urlLista } from '../lib/liste/parametri';
import { leggiPagina, numeroPagine, rispostaNonTrovata } from '../lib/paginazione';
import { generateBreadcrumbStructuredData, generateItemListStructuredData } from '../lib/seo';
import IntroSezione from '../components/liste/IntroSezione.astro';
import { INTRO_BANDI } from '../lib/liste/testi';
import type { Bando } from '../lib/supabase-bandi';

const DEF = DEF_BANDI;
const valori = leggiFiltri(Astro.url, DEF);
const pag = leggiPagina(Astro.url, DEF.base);
const pagina = pag.tipo === 'ok' ? pag.pagina : 1;

const normalizzato = normalizzazioneRichiesta(Astro.url, DEF, valori, pagina);
if (normalizzato) return Astro.redirect(normalizzato, 301);
if (pag.tipo === 'redirect') return Astro.redirect(pag.href, 301);

// Una sola dimensione filtrata ha un equivalente indicizzabile: la pagina statica.
// I valori dei filtri qui sono id di catalogo, quindi la traduzione passa dal corpus.
const unica = await dimensioneUnicaBandi(valori, pagina);
if (unica) {
  const pubblicate = await vociPubblicate(DEF.sezione, unica.dimensione);
  if (pubblicate.some((v) => v.slug === unica.slug)) {
    return Astro.redirect(hrefFiltro(DEF.sezione, unica.dimensione, unica.slug), 302);
  }
}

const { righe, totale } = await caricaBandi(valori, pagina);
const pagine = numeroPagine(totale, DEF.perPagina);
if (pagina > pagine || (righe.length === 0 && pagina > 1)) {
  return rispostaNonTrovata('Pagina non trovata', 'La pagina richiesta non esiste.', DEF.base, 'Torna ai bandi');
}

const opzioni = await opzioniFiltroBandi();
const conFiltri = filtriAttivi(valori) > 0;
const { canonical, robots } = seoLista(DEF, valori, pagina);

const pageTitle = pagina > 1
  ? `Bandi e finanziamenti pubblici: pagina ${pagina} di ${pagine} - EduNews24`
  : 'Bandi e finanziamenti pubblici - EduNews24';
const pageDescription = pagina > 1
  ? `Bandi europei, nazionali e regionali, pagina ${pagina} di ${pagine}: filtra per regione, settore, beneficiario, tipologia, importo e scadenza.`
  // Description 153 caratteri, con i programmi al posto dell'elenco dei filtri.
  : 'Bandi di finanziamento europei, nazionali e regionali aggiornati ogni giorno: FESR, FSE+, PNRR e bandi regionali. Filtra per regione, settore e scadenza.';
const pageKeywords = 'bandi, finanziamenti, FESR, FSE, Interreg, OpenCoesione, fondi europei, regionali, nazionali, codici ATECO';

const blocchiEsplora: Array<{ titolo: string; voci: Array<{ etichetta: string; href: string; totale: number }>; hrefTutti: string }> = [];
for (const dimEsplora of hubDisponibili(DEF.sezione)) {
  const vociEsplora = await vociPubblicate(DEF.sezione, dimEsplora.slug);
  if (vociEsplora.length === 0) continue;
  blocchiEsplora.push({
    titolo: `Esplora per ${dimEsplora.etichetta.toLowerCase()}`,
    voci: vociEsplora.slice(0, 24).map((v) => ({ etichetta: v.etichetta, href: hrefFiltro(DEF.sezione, dimEsplora.slug, v.slug), totale: v.totale })),
    hrefTutti: hrefHub(DEF.sezione, dimEsplora.slug),
  });
}

const breadcrumbStructuredData = generateBreadcrumbStructuredData({ category: 'Bandi', category_slug: 'bandi' });
const itemListItems = righe
  .filter((b: Bando) => b.slug && b.titolo)
  .map((b: Bando) => ({ href: `/bandi/${b.slug}`, title: b.titolo }));
const itemListStructuredData = itemListItems.length > 0
  ? generateItemListStructuredData(itemListItems, 'Bandi e finanziamenti pubblici', canonical, (pagina - 1) * DEF.perPagina + 1)
  : null;

const hrefPrec = pagina > 2 ? urlLista(DEF, valori, pagina - 1) : pagina === 2 ? urlLista(DEF, valori, 1) : null;
const hrefSucc = pagina < pagine ? urlLista(DEF, valori, pagina + 1) : null;
const basePaginazione = urlLista(DEF, valori, 1);
const selezionato = (nome: string, valore: string) => (valori[nome] ?? []).includes(valore);
---
<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} image="https://edunews24.it/og-bandi.png" canonicalUrl={canonical} robots={robots}>
  <script type="application/ld+json" set:html={breadcrumbStructuredData} slot="head" />
  {itemListStructuredData && <script type="application/ld+json" set:html={itemListStructuredData} slot="head" />}
  {hrefPrec && <link rel="prev" href={`https://edunews24.it${hrefPrec}`} slot="head" />}
  {hrefSucc && <link rel="next" href={`https://edunews24.it${hrefSucc}`} slot="head" />}

  <main class="bg-gray-50 min-h-screen">
    <div class="bg-gradient-to-r from-blue-700 to-indigo-800 text-white py-10 px-4 sm:px-6 lg:px-8">
      <div class="container mx-auto max-w-6xl">
        <nav class="flex text-sm text-blue-200 mb-4" aria-label="Breadcrumb">
          <ol class="inline-flex items-center space-x-1">
            <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
            <li class="flex items-center">
              <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
              <span class="text-white font-medium">Bandi</span>
            </li>
          </ol>
        </nav>
        <h1 class="text-3xl md:text-4xl font-bold mb-2">Bandi e finanziamenti pubblici</h1>
        <p class="text-blue-100 text-lg max-w-2xl leading-relaxed">
          Bandi europei (FESR, FSE, Interreg, JTF), nazionali e regionali aggiornati ogni giorno.
          <span class="text-white font-semibold">Non sai quale fa per te?</span> Il nostro staff e i nostri strumenti AI ti accompagnano dalla scelta alla candidatura.
        </p>
        <div class="mt-5 flex flex-wrap items-center gap-3 text-sm">
          <a
            href={bandofitCtaUrl('lista-hero')}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Parla con un esperto su BandoFit (si apre in una nuova scheda)"
            class="group inline-flex items-center gap-2 px-5 py-2.5 bg-white text-blue-700 font-semibold rounded-full shadow-lg hover:shadow-xl hover:bg-blue-50 hover:scale-[1.03] active:scale-[0.98] transition-all duration-200 focus:outline-none focus:ring-4 focus:ring-white/40"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z" /></svg>
            <span>Parla con un esperto</span>
            <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
          </a>
          <span class="inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm px-3 py-1.5 rounded-full text-white/90 ring-1 ring-white/10">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <span id="hero-count">{totale}</span> bandi disponibili
          </span>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 max-w-6xl -mt-6">
      {/* Banner CTA "Hai bisogno di un esperto?" */}
      <div class="mb-6">
        <BandiExpertCta variant="full-width" utmContent="lista-banner" />
      </div>

      {/* Filtri: form GET, funzionante anche senza JavaScript */}
      <form id="filtri" method="get" action="/bandi" data-frammento="/api/lista/bandi" data-lista="bandi-list"
            class="mb-6 bg-white rounded-xl shadow-md border border-gray-100 overflow-visible">
        {/* Header (clickable). NB: usiamo div role=button, NON un <button>, perche'
            il Reset interno e' anch'esso un <button> e nesting di button non e' valido
            HTML: il browser auto-chiuderebbe il toggle prima del Reset e il body
            del pannello finirebbe FUORI dalla card. */}
        <div
          id="filters-toggle"
          role="button"
          tabindex="0"
          class="w-full flex items-center justify-between gap-3 p-4 sm:p-5 text-left hover:bg-gray-50 transition-colors rounded-t-xl cursor-pointer select-none"
          aria-expanded="true"
          aria-controls="filters-body"
        >
          <div class="flex items-center gap-3 min-w-0">
            <span class="shrink-0 inline-flex items-center justify-center w-9 h-9 rounded-lg bg-blue-50 text-blue-600">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"></path></svg>
            </span>
            <div class="min-w-0">
              <span class="block font-heading font-semibold text-gray-900 leading-tight">Filtri</span>
              <p class="text-xs text-gray-500 mt-0.5 hidden sm:block">Affina la ricerca tra i bandi disponibili</p>
            </div>
            <span id="active-filters-badge" class="hidden ml-2 inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-blue-100 text-blue-700">
              <span id="active-count">0</span>&nbsp;attiv<span id="active-pluralize">i</span>
            </span>
          </div>
          <div class="flex items-center gap-3 shrink-0">
            <button
              type="button"
              id="reset-filters"
              class="hidden sm:inline-flex items-center gap-1 px-3 py-1.5 text-xs font-medium text-gray-500 hover:text-gray-800 transition-colors rounded-md hover:bg-gray-100"
              data-no-toggle="true"
            >
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
              Resetta
            </button>
            <svg id="filters-chevron" class="w-5 h-5 text-gray-400 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
          </div>
        </div>

        {/* Body */}
        <div id="filters-body" class="border-t border-gray-100 px-4 sm:px-5 pb-5 pt-4 space-y-5">
          <div>
            <label for="search-filter" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Ricerca testuale</label>
            <div class="relative">
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              <input type="search" id="search-filter" name="q" value={valori.q[0] ?? ''} placeholder="Cerca per titolo, ente o descrizione..." class="w-full pl-10 pr-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm bg-gray-50 transition-colors">
            </div>
          </div>

          {/* Sei tendine a scelta multipla. Le opzioni sono checkbox REALI rese dal
              server: prima erano iniettate via JS a partire da un define:vars che
              serializzava tutti i codici ATECO, i settori e i programmi nell'HTML,
              insieme a URL e chiave anon di Supabase. */}
          <div>
            <span class="block font-heading text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Categorie</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
              {MULTISELECT.map((m) => (
                <div class="multiselect relative" data-name={m.nome}>
                  <button type="button" class="ms-trigger w-full flex items-center justify-between gap-2 px-3 py-2.5 border border-gray-200 rounded-lg text-sm bg-gray-50 hover:bg-gray-100 hover:border-gray-300 transition-colors text-left">
                    <span class="ms-display flex-1 truncate text-gray-500" data-empty={m.etichetta}>{m.etichetta}</span>
                    <span class="ms-count hidden shrink-0 inline-flex items-center justify-center min-w-[1.25rem] h-5 px-1.5 text-[10px] font-bold bg-blue-600 text-white rounded-full">0</span>
                    <svg class="ms-chevron w-4 h-4 text-gray-400 transition-transform shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                  </button>
                  <div class="ms-popover hidden absolute z-30 left-0 right-0 mt-1 bg-white border border-gray-200 rounded-lg shadow-lg overflow-hidden">
                    <div class="p-2 border-b border-gray-100">
                      <div class="relative">
                        <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                        <input type="text" class="ms-search w-full pl-8 pr-2 py-1.5 text-sm bg-gray-50 border border-gray-200 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500" placeholder="Cerca...">
                      </div>
                    </div>
                    <div class="ms-list max-h-64 overflow-y-auto py-1">
                      {(opzioni.multiselect[m.nome] ?? []).map((o) => (
                        <label>
                          <input type="checkbox" name={m.nome} value={o.value} checked={selezionato(m.nome, o.value)}>
                          <span>{o.label}</span>
                        </label>
                      ))}
                    </div>
                    <div class="ms-footer p-2 border-t border-gray-100 flex items-center justify-between text-xs">
                      <button type="button" class="ms-clear text-gray-500 hover:text-gray-800 font-medium">Pulisci</button>
                      <span class="ms-status text-gray-400">0 selezionati</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          {/* Chip: checkbox mascherate, cosi' funzionano anche senza JavaScript */}
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
            <div>
              <span class="block font-heading text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Tipologia</span>
              <div id="tipologia-chips" class="flex flex-wrap gap-2">
                {opzioni.tipologie.map((t) => (
                  <label class="cursor-pointer">
                    <input type="checkbox" name="tipologia" value={t.value} checked={selezionato('tipologia', t.value)} class="peer sr-only">
                    <span class="block px-3 py-1.5 rounded-full text-xs font-semibold border border-gray-200 bg-gray-50 text-gray-700 hover:bg-gray-100 transition-colors peer-checked:bg-blue-600 peer-checked:text-white peer-checked:border-blue-600 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500">{t.label}</span>
                  </label>
                ))}
              </div>
            </div>
            <div>
              <span class="block font-heading text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Stato bando</span>
              <div id="scadenza-chips" class="flex flex-wrap gap-2">
                {opzioni.stati.map((s) => (
                  <label class="cursor-pointer">
                    <input type="checkbox" name="stato" value={s.value} checked={selezionato('stato', s.value)} class="peer sr-only">
                    <span class="block px-3 py-1.5 rounded-full text-xs font-semibold border border-gray-200 bg-gray-50 text-gray-700 hover:bg-gray-100 transition-colors peer-checked:bg-blue-600 peer-checked:text-white peer-checked:border-blue-600 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500">{s.label}</span>
                  </label>
                ))}
              </div>
            </div>
          </div>

          <div>
            <span class="block font-heading text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Importo e scadenza</span>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
              <div>
                <label for="importo-min" class="block text-xs text-gray-500 mb-1">Importo min (€)</label>
                <input type="number" id="importo-min" name="imin" value={valori.imin[0] ?? ''} min="0" step="1000" placeholder="0" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm bg-gray-50">
              </div>
              <div>
                <label for="importo-max" class="block text-xs text-gray-500 mb-1">Importo max (€)</label>
                <input type="number" id="importo-max" name="imax" value={valori.imax[0] ?? ''} min="0" step="1000" placeholder="∞" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm bg-gray-50">
              </div>
              <div>
                <label for="scadenza-da" class="block text-xs text-gray-500 mb-1">Scadenza da</label>
                <input type="date" id="scadenza-da" name="scad_da" value={valori.scad_da[0] ?? ''} class="w-full px-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm bg-gray-50">
              </div>
              <div>
                <label for="scadenza-a" class="block text-xs text-gray-500 mb-1">Scadenza a</label>
                <input type="date" id="scadenza-a" name="scad_a" value={valori.scad_a[0] ?? ''} class="w-full px-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-sm bg-gray-50">
              </div>
            </div>
          </div>

          <div class="flex flex-col sm:flex-row gap-2 pt-2 border-t border-gray-100">
            <button type="submit" class="flex-1 px-4 py-2.5 border border-blue-700 rounded-lg text-sm font-medium text-white bg-blue-700 hover:bg-blue-800 transition-colors">Applica filtri</button>
            <a href="/bandi" class="flex-1 px-4 py-2.5 border border-gray-200 rounded-lg text-sm font-medium text-gray-700 bg-gray-50 hover:bg-gray-100 transition-colors flex items-center justify-center gap-1.5">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
              Resetta filtri
            </a>
          </div>
        </div>
      </form>

      <div class="mb-4 flex items-center justify-between">
        <p id="results-count" class="text-sm text-gray-500">
          <span id="visible-count" class="font-semibold text-gray-700">{totale}</span> bandi trovati
        </p>
        <div id="loading-indicator" class="hidden items-center gap-2 text-sm text-blue-600">
          <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
          Caricamento...
        </div>
      </div>
      <p id="stato-risultati" class="sr-only" aria-live="polite"></p>

      <ListaBandi righe={righe} filtrata={conFiltri} />

      <PaginazioneLinks base={basePaginazione} pagina={pagina} pagine={pagine} accento="blu" />

      <IntroSezione intro={INTRO_BANDI} completa={pagina === 1 && !conFiltri} />

      {blocchiEsplora.map((b) => (
        <Sorelle titolo={b.titolo} voci={b.voci} hrefTutti={b.hrefTutti} />
      ))}
    </div>
  </main>
</Layout>

{/* Le opzioni delle tendine sono ~290: ripetere le utility Tailwind su ognuna
    costava oltre 60 KB di HTML per pagina. Lo stile e' identico, scritto una volta.
    is:global evita che Astro aggiunga un attributo di scope a ogni elemento. */}
<style is:global>
  .ms-list label {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.875rem;
    line-height: 1.25rem;
    color: rgb(55 65 81);
    cursor: pointer;
  }
  .ms-list label:hover { background-color: rgb(249 250 251); }
  .ms-list label[hidden] { display: none; }
  .ms-list input[type='checkbox'] {
    margin-top: 0.125rem;
    flex-shrink: 0;
    border-radius: 0.25rem;
    border-color: rgb(209 213 219);
    color: rgb(37 99 235);
  }
  .ms-list input[type='checkbox']:focus {
    outline: 2px solid transparent;
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px rgb(59 130 246);
  }
</style>

<script>
  import { attivaLista } from '../scripts/lista';
  import { attivaFiltriBandi } from '../scripts/bandi-filtri';
  attivaFiltriBandi();
  attivaLista({ idLista: 'bandi-list' });
</script>
