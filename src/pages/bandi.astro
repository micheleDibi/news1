---
import Layout from '../layouts/Layout.astro';
import BandoCard from '../components/bandi/BandoCard.astro';
import BandoFilters from '../components/bandi/BandoFilters.astro';
import BandiExpertCta from '../components/BandiExpertCta.astro';
import {
  supabaseBandi, loadCatalogo, BANDO_SELECT_LIST,
  type Bando, type Catalogo,
} from '../lib/supabase-bandi';

export const prerender = false;

const PAGE_SIZE = 20;
const url = new URL(Astro.request.url);
const params = url.searchParams;

function getMulti(name: string): string[] {
  const v = params.getAll(name);
  return v.filter(Boolean);
}
function getStr(name: string): string | undefined {
  const v = params.get(name);
  return v ? v.trim() : undefined;
}
function getNum(name: string): number | undefined {
  const v = params.get(name);
  if (!v) return undefined;
  const n = parseInt(v, 10);
  return Number.isFinite(n) ? n : undefined;
}

const selected = {
  q: getStr('q'),
  regione: getMulti('regione'),
  settore: getMulti('settore'),
  beneficiario: getMulti('beneficiario'),
  ateco: getMulti('ateco'),
  tipologia: getMulti('tipologia'),
  programma: getMulti('programma'),
  modalita: getMulti('modalita'),
  importo_min: getStr('importo_min'),
  importo_max: getStr('importo_max'),
  scadenza_da: getStr('scadenza_da'),
  scadenza_a: getStr('scadenza_a'),
  sort: getStr('sort') ?? 'data_scadenza_asc',
};
const page = Math.max(1, getNum('page') ?? 1);

// Junction subquery helper: ritorna l'array di bando_id che match
async function junctionBandoIds(table: string, fkColumn: string, ids: string[]): Promise<number[] | null> {
  if (ids.length === 0) return null;
  const numericIds = ids.map(i => parseInt(i, 10)).filter(Number.isFinite);
  if (numericIds.length === 0) return null;
  const { data, error } = await supabaseBandi
    .from(table)
    .select('bando_id')
    .in(fkColumn, numericIds);
  if (error || !data) return [];
  return Array.from(new Set(data.map((r: any) => r.bando_id)));
}

const catalogo: Catalogo = await loadCatalogo();

// Costruisci la query principale
let query = supabaseBandi
  .from('bando')
  .select(BANDO_SELECT_LIST, { count: 'exact' });

// Filtri junction-based (intersezione bando_ids da ogni junction filtrata)
let intersectIds: number[] | null = null;
const intersect = (ids: number[] | null) => {
  if (ids == null) return;
  if (intersectIds == null) {
    intersectIds = ids;
  } else {
    const set = new Set(ids);
    intersectIds = intersectIds.filter(i => set.has(i));
  }
};
intersect(await junctionBandoIds('bando_regioni', 'regione_id', selected.regione));
intersect(await junctionBandoIds('bando_settori', 'settore_id', selected.settore));
intersect(await junctionBandoIds('bando_beneficiari', 'beneficiario_id', selected.beneficiario));
intersect(await junctionBandoIds('bando_codici_ateco', 'codice_ateco_id', selected.ateco));

if (intersectIds != null) {
  if (intersectIds.length === 0) {
    // Filtri match zero bandi: forziamo nessun risultato
    query = query.eq('id', -1);
  } else {
    query = query.in('id', intersectIds);
  }
}

// Filtri FK
if (selected.tipologia.length > 0) {
  query = query.in('tipologia_bando_id', selected.tipologia.map(Number));
}
if (selected.programma.length > 0) {
  query = query.in('programma_id', selected.programma.map(Number));
}
if (selected.modalita.length > 0) {
  query = query.in('modalita_erogazione_id', selected.modalita.map(Number));
}

// Ricerca testuale: ilike su titolo/descrizione_breve/ente_erogatore
if (selected.q) {
  const safe = selected.q.replace(/[%,]/g, ' ');
  query = query.or(
    `titolo.ilike.%${safe}%,descrizione_breve.ilike.%${safe}%,ente_erogatore.ilike.%${safe}%`,
  );
}

// Importi
if (selected.importo_min) query = query.gte('importo_totale_eur', parseInt(selected.importo_min, 10));
if (selected.importo_max) query = query.lte('importo_totale_eur', parseInt(selected.importo_max, 10));

// Scadenza range
if (selected.scadenza_da) query = query.gte('data_scadenza', selected.scadenza_da);
if (selected.scadenza_a) query = query.lte('data_scadenza', selected.scadenza_a);

// Sort
const sortMap: Record<string, [string, boolean]> = {
  data_scadenza_asc: ['data_scadenza', true],
  data_pubblicazione_desc: ['data_pubblicazione', false],
  importo_totale_eur_desc: ['importo_totale_eur', false],
};
const [sortCol, sortAsc] = sortMap[selected.sort] ?? sortMap.data_scadenza_asc;
query = query.order(sortCol, { ascending: sortAsc, nullsFirst: false });

// Paginazione
const offset = (page - 1) * PAGE_SIZE;
query = query.range(offset, offset + PAGE_SIZE - 1);

const { data, count, error } = await query;
const bandi = (data ?? []) as Bando[];
const totalCount = count ?? 0;
const totalPages = Math.max(1, Math.ceil(totalCount / PAGE_SIZE));

if (error) {
  console.error('[bandi/list] supabase error:', error);
}

// Helper paginazione: costruisce URL preservando filtri
function pageUrl(p: number): string {
  const u = new URL(url.toString());
  u.searchParams.set('page', String(p));
  return u.pathname + '?' + u.searchParams.toString();
}

const pageTitle = 'Bandi e finanziamenti pubblici - EduNews24';
const pageDescription =
  'Trova bandi di finanziamento europei, nazionali e regionali. Filtra per regione, settore, beneficiari, tipologia, codici ATECO, programma, importo e scadenza.';
---

<Layout title={pageTitle} description={pageDescription}>
  <main class="bg-slate-50 min-h-screen">
    <header class="bg-white border-b border-slate-200">
      <div class="max-w-7xl mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold text-slate-900">Bandi e finanziamenti pubblici</h1>
        <p class="mt-2 text-slate-600 max-w-3xl">
          {pageDescription}
        </p>
        <p class="mt-3 text-sm text-slate-500">
          <strong class="text-slate-700">{totalCount}</strong> bandi disponibili
        </p>
      </div>
    </header>

    <div class="max-w-7xl mx-auto px-4 py-6 grid grid-cols-1 lg:grid-cols-[280px_1fr] gap-6">
      <aside class="lg:sticky lg:top-4 lg:self-start">
        <BandoFilters catalogo={catalogo} selected={selected} resultCount={totalCount} />
      </aside>

      <section>
        {bandi.length === 0 && (
          <div class="bg-white border border-slate-200 rounded-xl p-8 text-center">
            <p class="text-slate-700 font-medium">Nessun bando corrisponde ai filtri selezionati.</p>
            <a href="/bandi" class="inline-block mt-3 text-blue-700 underline">Reset filtri</a>
          </div>
        )}

        {bandi.length > 0 && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {bandi.map((bando) => (
              <BandoCard bando={bando} catalogo={catalogo} />
            ))}
          </div>
        )}

        {totalPages > 1 && (
          <nav class="mt-8 flex items-center justify-center gap-2" aria-label="Paginazione">
            {page > 1 && (
              <a href={pageUrl(page - 1)} class="px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm hover:bg-slate-50">‹ Precedente</a>
            )}
            <span class="px-3 py-2 text-sm text-slate-600">
              Pagina <strong>{page}</strong> di {totalPages}
            </span>
            {page < totalPages && (
              <a href={pageUrl(page + 1)} class="px-3 py-2 bg-white border border-slate-200 rounded-lg text-sm hover:bg-slate-50">Successiva ›</a>
            )}
          </nav>
        )}

        <div class="mt-10">
          <BandiExpertCta variant="full" />
        </div>
      </section>
    </div>
  </main>
</Layout>
