      else if (item.type === 'video') { title = item.title || 'Video & Reels'; sub = (item.article_count || 3) + ' reels'; }
      else if (item.type === 'video_by_category') { title = item.title || ('Reels ' + (item.category_slug || '')); sub = (item.article_count || 3) + ' reels · ' + (item.category_slug || ''); }

