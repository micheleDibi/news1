          </button>
        </div>`;
    }).join('');

    attachListListeners();
  }

  function attachListListeners() {
    document.querySelectorAll('.toggle-active').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id')!;
        const isActive = btn.getAttribute('data-active') === 'true';
        await supabase.from('linkinbio_items').update({ is_active: !isActive, updated_at: new Date().toISOString() }).eq('id', id);
        await loadItems();
      });
    });
    document.querySelectorAll('.edit-btn').forEach(btn => {
      btn.addEventListener('click', () => { const i = parseInt(btn.getAttribute('data-index')!); openPanel(allItems[i].type, allItems[i]); });
    });
    document.querySelectorAll('.delete-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('Eliminare questo elemento?')) return;
        await supabase.from('linkinbio_items').delete().eq('id', btn.getAttribute('data-id')!);
        await loadItems();
      });
    });

    // Drag and drop
    document.querySelectorAll('.item-card').forEach(card => {
      card.addEventListener('dragstart', (e) => {
        draggedIndex = parseInt((card as HTMLElement).dataset.index!);
        (card as HTMLElement).classList.add('dragging');
        (e as DragEvent).dataTransfer!.effectAllowed = 'move';
      });
      card.addEventListener('dragend', () => { (card as HTMLElement).classList.remove('dragging'); draggedIndex = null; document.querySelectorAll('.drag-over').forEach(c => c.classList.remove('drag-over')); });
      card.addEventListener('dragover', (e) => { e.preventDefault(); (e as DragEvent).dataTransfer!.dropEffect = 'move'; (card as HTMLElement).classList.add('drag-over'); });
      card.addEventListener('dragleave', () => (card as HTMLElement).classList.remove('drag-over'));
      card.addEventListener('drop', async (e) => {
        e.preventDefault();
        (card as HTMLElement).classList.remove('drag-over');
        const targetIndex = parseInt((card as HTMLElement).dataset.index!);
        if (draggedIndex === null || draggedIndex === targetIndex) return;
        await reorderItems(draggedIndex, targetIndex);
      });
    });
  }

  async function reorderItems(from: number, to: number) {
    const moved = allItems.splice(from, 1)[0];
    allItems.splice(to, 0, moved);
    const updates = allItems.map((item, i) => supabase.from('linkinbio_items').update({ position: i }).eq('id', item.id));
    await Promise.all(updates);
    await loadItems();
  }

  // Cache for dynamic articles (breaking/category)
  let previewDynArticles: Record<string, any[]> = {};

  const PREVIEW_SELECT = 'id, title, slug, category, category_slug, image_url, thumbnail_url, video_url, video_duration, excerpt, summary, creator, published_at';

  async function fetchPreviewDynArticles() {
    const dynamicItems = allItems.filter(i => i.is_active && (i.type === 'breaking' || i.type === 'category' || i.type === 'video' || i.type === 'video_by_category'));
    for (const item of dynamicItems) {
      if (previewDynArticles[item.id]) continue;
      if (item.type === 'breaking') {
        const { data } = await supabase.from('articles').select(PREVIEW_SELECT).eq('isdraft', false).order('published_at', { ascending: false }).limit(item.article_count || 15);
        previewDynArticles[item.id] = data || [];
      } else if (item.type === 'category' && item.category_slug) {
        const { data } = await supabase.from('articles').select(PREVIEW_SELECT).eq('category_slug', item.category_slug).eq('isdraft', false).order('published_at', { ascending: false }).limit(item.article_count || 3);
        previewDynArticles[item.id] = data || [];
      } else if (item.type === 'video') {
        const { data } = await supabase.from('articles').select(PREVIEW_SELECT).eq('isdraft', false).neq('video_url', '').neq('video_url', ' ').not('video_url', 'is', null).order('published_at', { ascending: false }).limit(item.article_count || 3);
        previewDynArticles[item.id] = data || [];
      } else if (item.type === 'video_by_category' && item.category_slug) {
        const { data } = await supabase.from('articles').select(PREVIEW_SELECT).eq('category_slug', item.category_slug).eq('isdraft', false).neq('video_url', '').neq('video_url', ' ').not('video_url', 'is', null).order('published_at', { ascending: false }).limit(item.article_count || 3);
        previewDynArticles[item.id] = data || [];
      }
    }
  }

  function previewTimeAgo(iso: string | null | undefined): string {
    if (!iso) return '';
    const then = new Date(iso).getTime();
    if (Number.isNaN(then)) return '';
    const diff = Math.max(0, Date.now() - then);
    const min = Math.floor(diff / 60_000);
    if (min < 1) return 'ORA';
    if (min < 60) return `${min} MIN FA`;
    const hr = Math.floor(min / 60);
    if (hr < 24) return hr === 1 ? '1 ORA FA' : `${hr} ORE FA`;
    const days = Math.floor(hr / 24);
    if (days < 7) return days === 1 ? '1 GIORNO FA' : `${days} GIORNI FA`;
    const weeks = Math.floor(days / 7);
    if (weeks < 5) return weeks === 1 ? '1 SETTIMANA FA' : `${weeks} SETTIMANE FA`;
    const months = Math.floor(days / 30);
    if (months < 12) return months === 1 ? '1 MESE FA' : `${months} MESI FA`;
    const years = Math.floor(days / 365);
    return years === 1 ? '1 ANNO FA' : `${years} ANNI FA`;
  }

  function escHtml(s: string): string {
    return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

