---
import AdminLayout from '../../../layouts/AdminLayout.astro';
---

<!-- Loading screen -->
<div id="loading-screen" class="fixed inset-0 bg-white z-50 flex items-center justify-center">
  <div class="text-center">
    <div class="animate-spin rounded-full h-12 w-12 border-b-2 border-indigo-600 mb-4"></div>
    <p class="text-gray-500 text-sm">Caricamento editor...</p>
  </div>
</div>

<div id="admin-content" class="hidden">
  <AdminLayout title="Link in Bio Editor">
    <div class="h-[calc(100vh-4rem)] flex flex-col">
      <!-- Top bar -->
      <div class="bg-white border-b border-gray-200 px-6 py-3 flex items-center justify-between flex-shrink-0">
        <div class="flex items-center gap-3">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center">
              <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
            </div>
            <div>
              <h1 class="text-lg font-semibold text-gray-900 leading-tight">Link in Bio</h1>
              <p class="text-xs text-gray-400">linkinbio.edunews24.it</p>
            </div>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <span id="item-count" class="text-xs text-gray-400 mr-2"></span>
          <a href="https://linkinbio.edunews24.it" target="_blank" rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 px-3 py-1.5 text-sm font-medium text-gray-600 bg-white border border-gray-200 rounded-lg hover:bg-gray-50 hover:border-gray-300 transition-all">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
            Apri Sito
          </a>
        </div>
      </div>

      <!-- Main content: editor + preview -->
      <div class="flex-1 flex overflow-hidden">
        <!-- Left: Items editor -->
        <div class="flex-1 flex flex-col bg-gray-50 overflow-hidden">
          <!-- Add element trigger -->
          <div class="px-4 py-2.5 border-b border-gray-200 bg-white flex-shrink-0">
            <div class="relative" id="add-menu-wrapper">
              <button id="add-menu-trigger" class="w-full flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl border-2 border-dashed border-gray-300 text-gray-500 hover:border-indigo-400 hover:text-indigo-600 hover:bg-indigo-50/50 transition-all group">
                <svg id="add-menu-icon" class="w-5 h-5 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                <span class="text-sm font-medium">Aggiungi elemento</span>
              </button>
              <!-- Dropdown -->
              <div id="add-menu-dropdown" class="absolute left-0 right-0 top-full mt-1.5 bg-white rounded-2xl shadow-[0_12px_40px_rgba(0,0,0,0.12)] border border-gray-100 z-30 overflow-hidden opacity-0 scale-95 pointer-events-none origin-top transition-all duration-200">
                <!-- Contenuti -->
                <div class="p-2">
                  <div class="px-3 pt-2 pb-1.5"><span class="text-[10px] font-semibold uppercase tracking-widest text-gray-300">Contenuti</span></div>
                  <button class="add-type-btn w-full flex items-center gap-3 px-3 py-2 rounded-lg text-left hover:bg-gray-50 transition-colors" data-type="article">
                    <div class="w-8 h-8 rounded-md bg-blue-500 text-white flex items-center justify-center flex-shrink-0">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    </div>
                    <div class="flex-1"><div class="text-[13px] font-medium text-gray-800">Articolo singolo</div><div class="text-[11px] text-gray-400 leading-tight">Seleziona un articolo dal sito</div></div>
                    <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </button>
                  <button class="add-type-btn w-full flex items-center gap-3 px-3 py-2 rounded-lg text-left hover:bg-gray-50 transition-colors" data-type="breaking">
                    <div class="w-8 h-8 rounded-md bg-red-500 text-white flex items-center justify-center flex-shrink-0">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    </div>
                    <div class="flex-1"><div class="text-[13px] font-medium text-gray-800">Ultima Ora</div><div class="text-[11px] text-gray-400 leading-tight">Ultimi articoli pubblicati</div></div>
                    <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </button>
                  <button class="add-type-btn w-full flex items-center gap-3 px-3 py-2 rounded-lg text-left hover:bg-gray-50 transition-colors" data-type="category">
                    <div class="w-8 h-8 rounded-md bg-orange-500 text-white flex items-center justify-center flex-shrink-0">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                    </div>
                    <div class="flex-1"><div class="text-[13px] font-medium text-gray-800">Categoria</div><div class="text-[11px] text-gray-400 leading-tight">Ultimi articoli per categoria</div></div>
                    <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </button>
                  <button class="add-type-btn w-full flex items-center gap-3 px-3 py-2 rounded-lg text-left hover:bg-gray-50 transition-colors" data-type="video">
                    <div class="w-8 h-8 rounded-md bg-purple-500 text-white flex items-center justify-center flex-shrink-0">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                    </div>
                    <div class="flex-1"><div class="text-[13px] font-medium text-gray-800">Video</div><div class="text-[11px] text-gray-400 leading-tight">Ultimi articoli con video</div></div>
                    <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </button>
                  <button class="add-type-btn w-full flex items-center gap-3 px-3 py-2 rounded-lg text-left hover:bg-gray-50 transition-colors" data-type="video_by_category">
                    <div class="w-8 h-8 rounded-md bg-fuchsia-500 text-white flex items-center justify-center flex-shrink-0">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 15l3 2.5L18 20"/></svg>
                    </div>
                    <div class="flex-1"><div class="text-[13px] font-medium text-gray-800">Reels per categoria</div><div class="text-[11px] text-gray-400 leading-tight">Video di una categoria specifica</div></div>
                    <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </button>
                  <button class="add-type-btn w-full flex items-center gap-3 px-3 py-2 rounded-lg text-left hover:bg-gray-50 transition-colors" data-type="link">
                    <div class="w-8 h-8 rounded-md bg-emerald-500 text-white flex items-center justify-center flex-shrink-0">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"/></svg>
                    </div>
                    <div class="flex-1"><div class="text-[13px] font-medium text-gray-800">Link esterno</div><div class="text-[11px] text-gray-400 leading-tight">URL personalizzato</div></div>
                    <svg class="w-4 h-4 text-gray-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                  </button>
                </div>
                <div class="border-t border-gray-100"></div>
                <!-- Layout & Social -->
                <div class="p-2">
                  <div class="px-3 pt-1 pb-1.5"><span class="text-[10px] font-semibold uppercase tracking-widest text-gray-300">Layout & Social</span></div>
                  <div class="grid grid-cols-3 gap-1">
                    <button class="add-type-btn flex flex-col items-center gap-1 py-2.5 px-2 rounded-lg hover:bg-gray-50 transition-colors" data-type="social">
                      <div class="w-7 h-7 rounded-md bg-violet-500 text-white flex items-center justify-center">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
                      </div>
                      <span class="text-[11px] font-medium text-gray-600">Social</span>
                    </button>
                    <button class="add-type-btn flex flex-col items-center gap-1 py-2.5 px-2 rounded-lg hover:bg-gray-50 transition-colors" data-type="header">
                      <div class="w-7 h-7 rounded-md bg-slate-500 text-white flex items-center justify-center">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7"/></svg>
                      </div>
                      <span class="text-[11px] font-medium text-gray-600">Intestazione</span>
                    </button>
                    <button class="add-type-btn flex flex-col items-center gap-1 py-2.5 px-2 rounded-lg hover:bg-gray-50 transition-colors" data-type="separator">
                      <div class="w-7 h-7 rounded-md bg-amber-500 text-white flex items-center justify-center">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 12H4"/></svg>
                      </div>
                      <span class="text-[11px] font-medium text-gray-600">Separatore</span>
                    </button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Items list -->
          <div class="flex-1 overflow-y-auto px-4 py-3" id="items-container">
            <div id="items-list" class="space-y-2">
              <div class="text-center py-12 text-gray-400 text-sm">Caricamento...</div>
            </div>
          </div>
        </div>

        <!-- Right: Live Preview -->
        <div class="w-[380px] flex-shrink-0 border-l border-gray-200 bg-gray-100 flex flex-col overflow-hidden hidden lg:flex">
          <div class="px-4 py-2.5 bg-white border-b border-gray-200 flex items-center justify-between flex-shrink-0">
            <span class="text-xs font-medium text-gray-500 uppercase tracking-wider">Anteprima</span>
            <div class="flex items-center gap-1.5">
              <div class="w-2 h-2 rounded-full bg-green-400"></div>
              <span class="text-xs text-gray-400">Live</span>
            </div>
          </div>
          <div class="flex-1 overflow-y-auto flex justify-center py-4">
            <div class="w-[320px]">
              <div class="bg-[#111827] rounded-[2rem] p-1 shadow-2xl">
                <div class="rounded-[1.75rem] overflow-hidden">
                  <div class="bg-[#111827] flex justify-center pt-2 pb-1">
                    <div class="w-20 h-5 bg-black rounded-full"></div>
                  </div>
                  <div id="preview-content" class="bg-[#faf7f2] px-4 pb-6 min-h-[500px]" style="font-family: 'Poppins', sans-serif;"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </AdminLayout>

  <!-- Slide-over panel for Add/Edit -->
  <div id="item-panel" class="fixed inset-0 z-50 hidden">
    <div class="absolute inset-0 bg-gray-900/50 backdrop-blur-sm" id="panel-backdrop"></div>
    <div class="absolute inset-y-0 right-0 w-full max-w-lg bg-white shadow-2xl flex flex-col transform translate-x-full transition-transform duration-300 ease-out" id="panel-drawer">
      <!-- Panel header -->
      <div class="px-6 py-4 border-b border-gray-200 flex items-center justify-between flex-shrink-0">
        <h2 id="modal-title" class="text-lg font-semibold text-gray-900">Aggiungi Elemento</h2>
        <button id="cancel-btn" class="p-2 text-gray-400 hover:text-gray-600 rounded-lg hover:bg-gray-100 transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <!-- Panel body -->
      <div class="flex-1 overflow-y-auto px-6 py-5">
        <form id="item-form">
          <input type="hidden" id="item-id">

          <!-- Type selector as cards -->
          <div class="mb-6" id="type-selector-section">
            <label class="block text-sm font-medium text-gray-700 mb-3">Tipo di elemento</label>
            <div class="grid grid-cols-4 gap-2" id="type-cards">
              <button type="button" class="type-card flex flex-col items-center gap-1 p-3 rounded-xl border-2 transition-all hover:shadow-sm" data-type="article">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
                <span class="text-[10px] font-medium">Articolo</span>
              </button>
              <button type="button" class="type-card flex flex-col items-center gap-1 p-3 rounded-xl border-2 transition-all hover:shadow-sm" data-type="link">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                <span class="text-[10px] font-medium">Link</span>
              </button>
              <button type="button" class="type-card flex flex-col items-center gap-1 p-3 rounded-xl border-2 transition-all hover:shadow-sm" data-type="social">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/></svg>
                <span class="text-[10px] font-medium">Social</span>
              </button>
              <button type="button" class="type-card flex flex-col items-center gap-1 p-3 rounded-xl border-2 transition-all hover:shadow-sm" data-type="breaking">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                <span class="text-[10px] font-medium">Ultima Ora</span>
              </button>
              <button type="button" class="type-card flex flex-col items-center gap-1 p-3 rounded-xl border-2 transition-all hover:shadow-sm" data-type="category">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                <span class="text-[10px] font-medium">Categoria</span>
              </button>
              <button type="button" class="type-card flex flex-col items-center gap-1 p-3 rounded-xl border-2 transition-all hover:shadow-sm" data-type="video">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                <span class="text-[10px] font-medium">Video</span>
              </button>
              <button type="button" class="type-card flex flex-col items-center gap-1 p-3 rounded-xl border-2 transition-all hover:shadow-sm" data-type="video_by_category">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h7"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 15l3 2.5L18 20"/></svg>
                <span class="text-[10px] font-medium">Reels cat.</span>
              </button>
              <button type="button" class="type-card flex flex-col items-center gap-1 p-3 rounded-xl border-2 transition-all hover:shadow-sm" data-type="header">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h7"/></svg>
                <span class="text-[10px] font-medium">Titolo</span>
              </button>
              <button type="button" class="type-card flex flex-col items-center gap-1 p-3 rounded-xl border-2 transition-all hover:shadow-sm" data-type="separator">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 12H4"/></svg>
                <span class="text-[10px] font-medium">Spazio</span>
              </button>
            </div>
          </div>
          <input type="hidden" id="item-type" value="article">

          <!-- Article section -->
          <div id="section-article" class="space-y-3">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5">Seleziona un articolo</label>
              <div id="selected-article" class="hidden mb-3 p-3 bg-indigo-50 border border-indigo-200 rounded-xl flex items-center gap-3">
                <div class="w-8 h-8 rounded-lg bg-indigo-100 flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                </div>
                <div class="flex-1 min-w-0">
                  <p id="selected-article-title" class="text-sm font-medium text-indigo-900 truncate"></p>
                  <p id="selected-article-category" class="text-xs text-indigo-600"></p>
                </div>
                <button type="button" id="clear-article" class="p-1 text-indigo-400 hover:text-indigo-600 rounded-lg hover:bg-indigo-100 transition-colors">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                </button>
              </div>
              <input type="hidden" id="item-article-id">
              <div class="flex gap-2">
                <div class="relative flex-1">
                  <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                  <input type="text" id="article-search" placeholder="Cerca per titolo..."
                    class="block w-full pl-10 pr-4 py-2.5 rounded-xl border border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 text-sm bg-gray-50 focus:bg-white transition-colors">
                </div>
                <select id="article-author-filter"
                  class="rounded-xl border border-gray-200 shadow-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 text-sm bg-gray-50 focus:bg-white transition-colors px-3 py-2.5">
                  <option value="">Tutti gli autori</option>
                </select>
              </div>
              <div id="article-results" class="mt-2 max-h-56 overflow-y-auto border border-gray-200 rounded-xl bg-white shadow-sm hidden"></div>
            </div>
          </div>

          <!-- Link section -->
          <div id="section-link" class="hidden space-y-4">
            <div>
              <label for="item-title" class="block text-sm font-medium text-gray-700 mb-1.5">Titolo</label>
              <input type="text" id="item-title" placeholder="Es: Visita il nostro blog"
