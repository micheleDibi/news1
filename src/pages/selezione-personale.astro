---
/**
 * Elenco di concorsi, avvisi di mobilita' e selezioni della Pubblica Amministrazione.
 *
 * Lo stato della lista vive nell'URL ed e' reso dal server; lo script client serve solo
 * a evitare il ricaricamento e chiede al server lo stesso frammento HTML.
 *
 * Ordinamento: annunci ancora aperti in cima. Il 90% del corpus ha una scadenza
 * passata mentre calculated_status dice 'Aperto' per tutti, quindi senza questo la
 * prima pagina sarebbe fatta quasi solo di annunci chiusi.
 */
export const prerender = false;

import Layout from '../layouts/Layout.astro';
import ListaSelezione from '../components/liste/ListaSelezione.astro';
import PaginazioneLinks from '../components/filtro/PaginazioneLinks.astro';
import Sorelle from '../components/filtro/Sorelle.astro';
import { vociPubblicate, hrefFiltro, hrefHub, hubDisponibili } from '../lib/pagine-filtro';
import { DEF_SELEZIONE, caricaListaSelezione, opzioniFiltroSelezione } from '../lib/liste/selezione-personale';
import {
  leggiFiltri, filtriAttivi, normalizzazioneRichiesta, dimensioneUnica, seoLista, urlLista,
} from '../lib/liste/parametri';
import { leggiPagina, numeroPagine, rispostaNonTrovata } from '../lib/paginazione';
import { generateBreadcrumbStructuredData, generateItemListStructuredData } from '../lib/seo';
import IntroSezione from '../components/liste/IntroSezione.astro';
import { INTRO_SELEZIONE } from '../lib/liste/testi';
import type { SelezioneBando } from '../types/bandi';

const DEF = DEF_SELEZIONE;
const valori = leggiFiltri(Astro.url, DEF);
const pag = leggiPagina(Astro.url, DEF.base);
const pagina = pag.tipo === 'ok' ? pag.pagina : 1;

const normalizzato = normalizzazioneRichiesta(Astro.url, DEF, valori, pagina);
if (normalizzato) return Astro.redirect(normalizzato, 301);
if (pag.tipo === 'redirect') return Astro.redirect(pag.href, 301);

// Una sola dimensione filtrata ha un equivalente indicizzabile: la pagina statica.
const unica = dimensioneUnica(DEF, valori, pagina);
if (unica) {
  const pubblicate = await vociPubblicate(DEF.sezione, unica.dimensione);
  if (pubblicate.some((v) => v.slug === unica.slug)) {
    return Astro.redirect(hrefFiltro(DEF.sezione, unica.dimensione, unica.slug), 302);
  }
}

const { righe, totale } = await caricaListaSelezione(valori, pagina);
const pagine = numeroPagine(totale, DEF.perPagina);
if (pagina > pagine || (righe.length === 0 && pagina > 1)) {
  return rispostaNonTrovata('Pagina non trovata', 'La pagina richiesta non esiste.', DEF.base, 'Torna ai bandi');
}

const opzioni = await opzioniFiltroSelezione();
const conFiltri = filtriAttivi(valori) > 0;
const { canonical, robots } = seoLista(DEF, valori, pagina);

// La description precedente parlava di "migliori aziende private": la pagina contiene
// solo Pubblica Amministrazione. Title 54 caratteri, description 143.
const pageTitle = pagina > 1
  ? `Concorsi pubblici: pagina ${pagina} di ${pagine} - EduNews24`
  : 'Concorsi pubblici e selezione personale PA - EduNews24';
const pageDescription = pagina > 1
  ? `Concorsi e avvisi della Pubblica Amministrazione, pagina ${pagina} di ${pagine}: filtra per categoria, settore e sede.`
  : 'Concorsi, avvisi di mobilità e selezioni di professionisti pubblicati da enti e amministrazioni italiane: filtra per categoria, settore e sede.';
const pageKeywords = 'selezione personale, lavoro, ricerca lavoro, offerte lavoro, annunci lavoro, pubblica amministrazione, bandi pubblici, bandi e concorsi';

const blocchiEsplora: Array<{ titolo: string; voci: Array<{ etichetta: string; href: string; totale: number }>; hrefTutti: string }> = [];
for (const dimEsplora of hubDisponibili(DEF.sezione)) {
  const vociEsplora = await vociPubblicate(DEF.sezione, dimEsplora.slug);
  if (vociEsplora.length === 0) continue;
  blocchiEsplora.push({
    titolo: `Esplora per ${dimEsplora.etichetta.toLowerCase()}`,
    voci: vociEsplora.slice(0, 24).map((v) => ({ etichetta: v.etichetta, href: hrefFiltro(DEF.sezione, dimEsplora.slug, v.slug), totale: v.totale })),
    hrefTutti: hrefHub(DEF.sezione, dimEsplora.slug),
  });
}

const breadcrumbStructuredData = generateBreadcrumbStructuredData({
  category: 'Selezione Personale',
  category_slug: 'selezione-personale',
});
const itemListItems = righe
  .filter((b: SelezioneBando) => b.slug && (b.article_title || b.titolo))
  .map((b: SelezioneBando) => ({ href: `/selezione-personale/${b.slug}`, title: b.article_title || b.titolo }));
const itemListStructuredData = itemListItems.length > 0
  ? generateItemListStructuredData(itemListItems, 'Selezione Personale', canonical, (pagina - 1) * DEF.perPagina + 1)
  : null;

const hrefPrec = pagina > 2 ? urlLista(DEF, valori, pagina - 1) : pagina === 2 ? urlLista(DEF, valori, 1) : null;
const hrefSucc = pagina < pagine ? urlLista(DEF, valori, pagina + 1) : null;
const basePaginazione = urlLista(DEF, valori, 1);
---
<Layout title={pageTitle} description={pageDescription} keywords={pageKeywords} canonicalUrl={canonical} robots={robots}>
  <script type="application/ld+json" set:html={breadcrumbStructuredData} slot="head" />
  {itemListStructuredData && <script type="application/ld+json" set:html={itemListStructuredData} slot="head" />}
  {hrefPrec && <link rel="prev" href={`https://edunews24.it${hrefPrec}`} slot="head" />}
  {hrefSucc && <link rel="next" href={`https://edunews24.it${hrefSucc}`} slot="head" />}

  <main class="bg-gray-50 min-h-screen">
    {/* Hero header */}
    <div class="bg-gradient-to-r from-yellow-700 to-yellow-800 text-white py-10 px-4 sm:px-6 lg:px-8">
      <div class="container mx-auto max-w-6xl">
        <nav class="flex text-sm text-yellow-200 mb-4" aria-label="Breadcrumb">
          <ol class="inline-flex items-center space-x-1">
            <li><a href="/" class="hover:text-white transition-colors">Home</a></li>
            <li class="flex items-center">
              <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
              <span class="text-white font-medium">Selezione Personale</span>
            </li>
          </ol>
        </nav>
        <h1 class="text-3xl md:text-4xl font-bold mb-2">Selezione Personale</h1>
        <p class="text-yellow-100 text-lg max-w-2xl">Bandi, concorsi pubblici e opportunità di lavoro nella Pubblica Amministrazione italiana.</p>
        {pagina > 1 && <p class="text-yellow-100 text-sm mt-1">Pagina {pagina} di {pagine}</p>}
        <div class="mt-4 flex items-center gap-4 text-sm">
          <span class="inline-flex items-center gap-1.5 bg-white/15 backdrop-blur-sm px-3 py-1.5 rounded-full">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <span id="hero-count">{totale}</span> bandi disponibili
          </span>
        </div>
      </div>
    </div>

    <div class="container mx-auto px-4 max-w-6xl -mt-6">
      {/* Filtri: form GET, funzionante anche senza JavaScript */}
      <form id="filtri" method="get" action="/selezione-personale" data-frammento="/api/lista/selezione-personale" data-lista="bandi-list" class="mb-6 p-5 bg-white rounded-xl shadow-md border border-gray-100">
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-6 gap-3 items-end">
          <div class="lg:col-span-2">
            <label for="search-filter" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Cerca</label>
            <div class="relative">
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
              <input type="search" id="search-filter" name="q" value={valori.q[0] ?? ''} placeholder="Titolo, Ente, Codice..." class="w-full pl-10 pr-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 text-sm bg-gray-50 transition-colors">
            </div>
          </div>

          <div>
            <label for="category-filter" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Categoria</label>
            <select id="category-filter" name="categoria" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 text-sm bg-gray-50">
              <option value="">Tutte</option>
              {opzioni.categorie.map((c) => <option value={c.slug} selected={valori.categoria[0] === c.slug}>{c.etichetta}</option>)}
            </select>
          </div>

          <div>
            <label for="settore-filter" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Settore</label>
            <select id="settore-filter" name="settore" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 text-sm bg-gray-50">
              <option value="">Tutti</option>
              {opzioni.settori.map((s) => <option value={s.slug} selected={valori.settore[0] === s.slug}>{s.etichetta}</option>)}
            </select>
          </div>

          <div>
            <label for="sede-filter" class="block text-xs font-semibold text-gray-500 uppercase tracking-wider mb-1.5">Sede</label>
            <select id="sede-filter" name="sede" class="w-full px-3 py-2.5 border border-gray-200 rounded-lg focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 text-sm bg-gray-50">
              <option value="">Tutte</option>
              {opzioni.sedi.map((s) => <option value={s.slug} selected={valori.sede[0] === s.slug}>{s.etichetta}</option>)}
            </select>
          </div>

          <div class="flex gap-2">
            <div class="flex-1">
              <label class="block text-xs font-semibold text-transparent mb-1.5">Filtra</label>
              <button type="submit" class="w-full px-4 py-2.5 border border-yellow-700 rounded-lg text-sm font-medium text-white bg-yellow-700 hover:bg-yellow-800 transition-colors">Filtra</button>
            </div>
            <div class="flex-1">
              <label class="block text-xs font-semibold text-transparent mb-1.5">Reset</label>
              <a id="reset-filters" href="/selezione-personale" class="w-full px-4 py-2.5 border border-gray-200 rounded-lg text-sm font-medium text-gray-600 bg-gray-50 hover:bg-gray-100 transition-colors flex items-center justify-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                Resetta
              </a>
            </div>
          </div>
        </div>
      </form>

      <div class="mb-4 flex items-center justify-between">
        <p id="results-count" class="text-sm text-gray-500">
          <span id="visible-count" class="font-semibold text-gray-700">{totale}</span> bandi trovati
        </p>
        <div id="loading-indicator" class="hidden items-center gap-2 text-sm text-yellow-700">
          <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
          Caricamento...
        </div>
      </div>
      <p id="stato-risultati" class="sr-only" aria-live="polite"></p>

      <ListaSelezione righe={righe} filtrata={conFiltri} />

      <PaginazioneLinks base={basePaginazione} pagina={pagina} pagine={pagine} accento="giallo" />

      <IntroSezione intro={INTRO_SELEZIONE} completa={pagina === 1 && !conFiltri} />

      {blocchiEsplora.map((b) => (
        <Sorelle titolo={b.titolo} voci={b.voci} hrefTutti={b.hrefTutti} />
      ))}
    </div>
  </main>
</Layout>

<script>
  import { attivaLista } from '../scripts/lista';
  attivaLista({ idLista: 'bandi-list' });
</script>
