---
/**
 * Testo introduttivo di una pagina elenco.
 *
 * Posizione: sotto la lista e sopra i blocchi di linking, non fra l'H1 e i filtri.
 * Centotrenta parole fra l'intestazione e i controlli spingerebbero filtri e primi
 * risultati sotto la piega su mobile; per un motore di ricerca la posizione nel
 * documento non cambia nulla, per chi usa la pagina si'.
 *
 * Sulle pagine oltre la prima si mostra una riga sola: ripetere lo stesso testo su
 * decine di URL paginati e' solo rumore.
 */
import type { IntroSezione } from '../../lib/liste/testi';

interface Props {
  intro: IntroSezione;
  /** true solo su pagina 1 senza filtri attivi. */
  completa: boolean;
  /** `bandi`: lo stile del design «Bandi Redesign». Senza, il markup di sempre. */
  variante?: 'bandi';
}

const { intro, completa, variante } = Astro.props;
---
{variante === 'bandi' ? (
  completa ? (
    <section class="mt-10 rounded-2xl border border-[#e3e7ee] bg-white p-[22px]">
      <h2 class="font-heading text-[19px] font-semibold text-[#0a2244]">{intro.titolo}</h2>
      <div class="mt-3 space-y-3 text-[14px] leading-[1.6] text-[#3d4657]">
        {intro.paragrafi.map((paragrafo) => (
          <p>
            {paragrafo.map((seg) => seg.tipo === 'link'
              ? <a href={seg.href} class="text-[#004e9c] underline underline-offset-2">{seg.testo}</a>
              : <Fragment>{seg.testo}</Fragment>)}
          </p>
        ))}
      </div>
    </section>
  ) : (
    <p class="mt-10 text-[13.5px] text-[#4b5565]">{intro.rigaBreve}</p>
  )
) : completa ? (
  <section class="mt-8 mb-10 p-5 sm:p-6 bg-white rounded-xl shadow-sm border border-gray-100">
    <h2 class="text-base font-bold text-gray-900 mb-3">{intro.titolo}</h2>
    <div class="text-sm text-gray-600 leading-relaxed space-y-3">
      {intro.paragrafi.map((paragrafo) => (
        <p>
          {paragrafo.map((seg) => seg.tipo === 'link'
            ? <a href={seg.href} class="text-gray-800 underline decoration-gray-300 hover:decoration-gray-600 transition-colors">{seg.testo}</a>
            : <Fragment>{seg.testo}</Fragment>)}
        </p>
      ))}
    </div>
  </section>
) : (
  <p class="mt-8 mb-6 text-sm text-gray-500">{intro.rigaBreve}</p>
)}
