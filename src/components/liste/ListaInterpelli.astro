---
/**
 * Contenitore della lista interpelli. Lo usano sia la pagina che la rotta frammento
 * chiamata dal JS dopo un cambio di filtro: e' cosi' che il markup della card resta
 * uno solo invece di essere duplicato in una stringa JavaScript.
 */
import CardInterpello from './CardInterpello.astro';
import type { Interpello } from '../../lib/liste/interpelli';

interface Props {
  righe: Interpello[];
  /** true se il vuoto dipende dai filtri e non dall'assenza di dati. */
  filtrata: boolean;
}

const { righe, filtrata } = Astro.props;
---
<div id="interpelli-list" class="space-y-4">
  {righe.length === 0 ? (
    <div id="no-results-message" class="text-center py-16 bg-white rounded-xl shadow-sm">
      <svg class="mx-auto w-16 h-16 text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
      <p class="text-gray-500 text-lg font-medium">Nessun interpello trovato</p>
      <p class="text-gray-400 text-sm mt-1">{filtrata ? 'Prova a modificare i filtri di ricerca' : 'Nessun interpello disponibile al momento'}</p>
    </div>
  ) : righe.map((interpello) => <CardInterpello interpello={interpello} />)}
</div>
