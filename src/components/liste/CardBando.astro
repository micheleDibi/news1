---
/**
 * Card di un bando di finanziamento. Unico template: lo usano la pagina elenco,
 * le pagine filtro e il frammento richiamato dal JS dopo un cambio di filtro.
 * La classe `bando-item` e' l'aggancio dello script client: non rimuoverla.
 *
 * Nel DOM il titolo viene prima della riga stato/scadenza, che `order-first`
 * riporta in cima a schermo: chi naviga per titoli (e il Markdown per agenti)
 * legge il titolo e subito dopo il suo stato, non quello della card precedente.
 * L'unico link e' il titolo; il suo `::after` copre la card, che resta
 * cliccabile per intero.
 */
import { statoEffettivo, todayRomeISO } from '../../lib/stato-bando';
import { BADGE_STATO, badgeStato, rigaScadenza } from '../../lib/bandi/testi-stato';
import type { Bando } from '../../lib/supabase-bandi';
import { formatImportoEuro } from '../../lib/liste/formato';

/** Bando arricchito in lista: le tre FK risolte a nome tramite il catalogo. */
export type BandoLista = Bando & {
  tipologia?: string | null;
  programma?: string | null;
  modalita_erogazione?: string | null;
};

interface Props {
  bando: BandoLista;
}

const { bando } = Astro.props;

// Badge sullo stato EFFETTIVO. Se la lista legge dalla vista, quel valore lo
// calcola il database (`stato_effettivo`) e conosce anche l'ora di scadenza e
// se la data di apertura ha una prova; altrimenti si ricostruisce dalla colonna
// corretta dalla scadenza, perche' `stato_bando` non viene piu' aggiornata dopo
// il preprocess. La card e il filtro della lista devono usare la STESSA
// sorgente, altrimenti un bando puo' comparire fra gli aperti con il badge
// «Chiuso». Etichetta e classi da `bandi/testi-stato.ts`.
const calcolato = (bando as unknown as Record<string, unknown>).stato_effettivo;
const stato = typeof calcolato === 'string' && calcolato !== ''
  ? (calcolato as ReturnType<typeof statoEffettivo>)
  : statoEffettivo({ stato: bando.stato_bando, data_scadenza: bando.data_scadenza });
const badge = badgeStato(stato);
// Lo stato sconosciuto ha «—» come etichetta: un segnaposto, quindi non si mostra.
const conBadge = badge !== BADGE_STATO.sconosciuto;

// «Oggi» di Roma, come nella scheda: mai l'ora locale del server.
const scadenza = rigaScadenza(stato, bando.data_scadenza, todayRomeISO());

// L'area si omette quando il nome dell'ente la contiene gia' («Regione Marche · Marche»).
const ente = bando.ente_erogatore?.trim() || null;
const area = bando.area_geografica?.trim() || null;
const areaUtile = area && !(ente ?? '').toLowerCase().includes(area.toLowerCase()) ? area : null;
const dettagli = [ente, areaUtile, bando.tipologia?.trim() || null].filter((v): v is string => v !== null);
---
<article class="bando-item relative flex flex-col gap-2 rounded-lg border border-gray-200 bg-white p-5 transition-colors hover:border-gray-400 motion-reduce:transition-none">
  <h2 class="font-heading text-lg font-semibold leading-snug text-gray-900 line-clamp-2">
    <a
      href={`/bandi/${bando.slug}`}
      class="hover:text-primary after:absolute after:inset-0 after:rounded-lg focus-visible:outline-none focus-visible:after:outline focus-visible:after:outline-2 focus-visible:after:outline-offset-2 focus-visible:after:outline-primary"
    >{bando.titolo}</a>
  </h2>

  {(conBadge || scadenza) && (
    <p class="order-first flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-gray-700">
      {conBadge && (
        <span class={`inline-flex items-center rounded-md px-2 py-0.5 text-xs font-semibold ${badge.classi}`}>{badge.etichetta}</span>
      )}
      {scadenza && <span class="tabular-nums">{scadenza.testo}</span>}
      {scadenza?.mancano && <span class="whitespace-nowrap tabular-nums text-gray-600">· {scadenza.mancano}</span>}
    </p>
  )}

  {dettagli.length > 0 && <p class="text-sm text-gray-600">{dettagli.join(' · ')}</p>}

  {bando.importo_totale_eur != null && (
    <p class="text-sm text-gray-700">
      Dotazione <span class="font-semibold tabular-nums text-gray-900">{formatImportoEuro(bando.importo_totale_eur)}</span>
    </p>
  )}

  {bando.descrizione_breve && (
    <p class="text-sm leading-relaxed text-gray-600 line-clamp-2">{bando.descrizione_breve}</p>
  )}
</article>
