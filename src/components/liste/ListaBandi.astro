---
/**
 * Contenitore della lista bandi, condiviso fra la pagina e la rotta frammento.
 */
import CardBando from './CardBando.astro';
import type { Bando } from '../../lib/supabase-bandi';

interface Props {
  righe: Bando[];
  filtrata: boolean;
}

const { righe, filtrata } = Astro.props;
---
<div id="bandi-list" class="space-y-3">
  {righe.length === 0 ? (
    <div id="no-results-message" class="rounded-lg border border-gray-200 bg-white px-6 py-12 text-center">
      <p class="font-heading text-lg font-semibold text-gray-900">Nessun bando trovato</p>
      <p class="mt-1 text-sm text-gray-600">{filtrata ? 'Prova a modificare i filtri di ricerca.' : 'Nessun bando disponibile al momento.'}</p>
    </div>
  ) : righe.map((bando) => <CardBando bando={bando} />)}
</div>
