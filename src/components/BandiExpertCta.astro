---
/**
 * Rimando a BandoFit, la piattaforma di supporto alla candidatura. Il nome si
 * legge nel testo del link, non solo negli attributi per gli screen reader.
 *
 * Due varianti:
 *  - `scheda`: blocco nella colonna della scheda /bandi/[slug], sotto il
 *    pannello di partecipazione. Resta secondario rispetto alla CTA ufficiale:
 *    link testuale, mai un secondo bottone pieno.
 *  - `riga`: una frase con il link, nell'header della lista /bandi.
 *
 * L'URL passa sempre da bandofitCtaUrl(): il chiamante dichiara la posizione,
 * che diventa lo utm_content. Non esiste una pagina BandoFit per singolo bando.
 */
import { bandofitCtaUrl, type BandofitCtaPosition } from '../lib/bandofit';

interface Props {
  variante: 'scheda' | 'riga';
  utmContent: BandofitCtaPosition;
  /**
   * Solo `scheda`: false quando il bando non accetta domande (chiuso, sospeso,
   * revocato). Il testo non invita a candidarsi, rimanda a misure alternative.
   */
  candidabile?: boolean;
}

const { variante, utmContent, candidabile = true } = Astro.props;
const href = bandofitCtaUrl(utmContent);

const classiLink =
  'inline-flex min-h-11 items-center gap-1.5 rounded-md font-semibold text-primary underline underline-offset-2 ' +
  'hover:text-primary-dark focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 ' +
  'focus-visible:outline-primary';
---

{variante === 'scheda' ? (
  <aside aria-label="BandoFit" class="border-t border-gray-200 pt-5">
    <p class="font-heading text-base font-semibold text-gray-900">
      {candidabile ? 'Supporto alla candidatura' : 'Misure alternative'}
    </p>
    <p class="mt-1 text-sm leading-relaxed text-gray-700">
      {candidabile
        ? 'Verifica i requisiti e prepara la domanda con i progettisti di BandoFit.'
        : 'Cerca misure alternative con i progettisti di BandoFit.'}
    </p>
    <a href={href} target="_blank" rel="noopener noreferrer" class={`mt-1 text-sm ${classiLink}`}>
      Vai a BandoFit<svg aria-hidden="true" focusable="false" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg><span class="sr-only"> (si apre in una nuova scheda)</span>
    </a>
  </aside>
) : (
  <p class="flex flex-wrap items-center gap-x-3 text-sm text-gray-700">
    <span>Supporto alla candidatura: verifica i requisiti e prepara la domanda con i progettisti di BandoFit.</span>{' '}
    <a href={href} target="_blank" rel="noopener noreferrer" class={classiLink}>
      Vai a BandoFit<svg aria-hidden="true" focusable="false" class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg><span class="sr-only"> (si apre in una nuova scheda)</span>
    </a>
  </p>
)}
