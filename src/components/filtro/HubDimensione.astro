---
/**
 * Pagina indice di una dimensione: /interpelli/regione, /bandi/programma, ...
 *
 * Ha anche un effetto collaterale voluto: prima di esistere, /interpelli/regione
 * cadeva su interpelli/[slug].astro e rispondeva 200 con "Interpello non Trovato",
 * cioe' un soft-404 indicizzabile. Un segmento statico vince su uno dinamico, quindi
 * questa pagina lo copre con contenuto vero.
 */
import Layout from '../../layouts/Layout.astro';
import Sorelle from './Sorelle.astro';
import TestataBandi from '../bandi/TestataBandi.astro';
import { generateBreadcrumbStructuredData } from '../../lib/seo';
import { configSezione, dimensione as trovaDimensione, type Sezione } from '../../config/pagine-filtro';
import { vociPubblicate, hrefFiltro, hubDisponibili, hrefHub } from '../../lib/pagine-filtro';

interface Props {
  sezione: Sezione;
  dimensione: string;
}

const { sezione, dimensione: slugDimensione } = Astro.props;
const cfg = configSezione(sezione);
// La pagina che monta questo componente ha gia' verificato che la dimensione
// esista, sia abilitata e abbia almeno una voce pubblicata (hubNonDisponibile).
const dim = trovaDimensione(sezione, slugDimensione)!;

// Classi complete per sezione (vedi PaginaFiltro.astro): header chiaro per i
// bandi, banda colorata invariata byte per byte per interpelli e selezione.
const PALETTE = {
  interpelli: {
    testata: 'bg-gradient-to-r from-red-700 to-red-800 text-white py-10 px-4 sm:px-6 lg:px-8',
    briciole: 'flex text-sm text-red-200 mb-4',
    link: 'hover:text-white transition-colors',
    corrente: 'text-white font-medium',
    h1: 'text-3xl md:text-4xl font-bold mb-2',
    testo: 'text-white/80 text-sm',
  },
  'selezione-personale': {
    testata: 'bg-gradient-to-r from-yellow-700 to-yellow-800 text-white py-10 px-4 sm:px-6 lg:px-8',
    briciole: 'flex text-sm text-yellow-200 mb-4',
    link: 'hover:text-white transition-colors',
    corrente: 'text-white font-medium',
    h1: 'text-3xl md:text-4xl font-bold mb-2',
    testo: 'text-white/80 text-sm',
  },
  bandi: {
    // Padding sul contenitore interno, come nel corpo della pagina: breadcrumb e H1
    // si allineano alle card (con il padding esterno restavano 16px piu' a sinistra).
    testata: 'bg-white border-b border-gray-200 text-gray-900 py-8 sm:py-10 [&>div]:px-4',
    briciole: 'flex text-sm text-gray-600 mb-4',
    link: '-my-3 inline-block rounded-md py-3 underline-offset-2 hover:text-primary hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary',
    corrente: 'text-gray-900 font-medium',
    h1: 'font-heading text-3xl font-bold leading-tight text-gray-900 mb-2',
    testo: 'text-gray-600 text-sm',
  },
}[sezione];

const voci = await vociPubblicate(sezione, slugDimensione);
const base = hrefHub(sezione, slugDimensione);
const canonical = `https://edunews24.it${base}`;

const titolo = `${cfg.etichetta} per ${dim.etichetta.toLowerCase()}`;
const descrizione = `Tutte le ${dim.etichettaPlurale.toLowerCase()} con annunci pubblicati su EduNews24: ` +
  `${voci.length} pagine, aggiornate insieme all'elenco principale.`;

const breadcrumb = generateBreadcrumbStructuredData(
  { category: cfg.etichetta, category_slug: cfg.basePath.replace(/^\//, '') },
  { nome: dim.etichettaPlurale, url: canonical },
);

const altreDimensioni = hubDisponibili(sezione)
  .filter((d) => d.slug !== slugDimensione)
  .map((d) => ({ etichetta: d.etichettaPlurale, href: hrefHub(sezione, d.slug) }));
---
<Layout title={`${titolo} - EduNews24`} description={descrizione} canonicalUrl={canonical}>
  <script type="application/ld+json" set:html={breadcrumb} slot="head" />
  {sezione === 'bandi' ? (
  // Bandi: la testata scura e i colori del design «Bandi Redesign», come la
  // lista e le pagine filtro. Interpelli e selezione restano com'erano.
  <main class="font-[Poppins,system-ui,sans-serif] text-[#1a2233] antialiased leading-[normal]">
    <section class="relative bg-[#0a2244] text-white">
      <div class="mx-auto max-w-[1200px] px-4 pb-10 pt-9 sm:px-8">
        <TestataBandi
          briciole={[{ etichetta: 'Home', href: '/' }, { etichetta: 'Bandi', href: cfg.basePath }, { etichetta: dim.etichettaPlurale }]}
          titolo={titolo}
          testo={`${voci.length} ${voci.length === 1 ? 'pagina disponibile' : 'pagine disponibili'}`}
        />
      </div>
    </section>
    <section class="bg-[#f4f6f9] pb-16 pt-6">
      <div class="mx-auto max-w-[1200px] px-4 sm:px-8">
        <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {voci.map((v) => (
            <li>
              <a href={hrefFiltro(sezione, slugDimensione, v.slug)}
                 class="flex items-baseline justify-between gap-3 rounded-xl border border-[#e3e7ee] bg-white px-[18px] py-3.5 no-underline transition-[border-color,box-shadow] duration-150 hover:border-[#9fb3d1] hover:shadow-[0_10px_28px_-18px_rgba(10,34,68,.45)] motion-reduce:transition-none focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#004e9c]">
                <span class="text-[15px] font-medium text-[#0a2244]">{v.etichetta}</span>
                <span class="shrink-0 text-[13px] tabular-nums text-[#6b7383]">{v.totale}</span>
              </a>
            </li>
          ))}
        </ul>

        {altreDimensioni.length > 0 && (
          <Sorelle titolo="Esplora anche" voci={altreDimensioni} variante="bandi" />
        )}
      </div>
    </section>
  </main>
  ) : (
  <main class="bg-gray-50 min-h-screen">
    <div class={PALETTE.testata}>
      <div class="container mx-auto max-w-6xl">
        <nav class={PALETTE.briciole} aria-label="Breadcrumb">
          <ol class="inline-flex items-center flex-wrap gap-y-1">
            <li><a href="/" class={PALETTE.link}>Home</a></li>
            <li class="flex items-center">
              <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
              <a href={cfg.basePath} class={PALETTE.link}>{cfg.etichetta}</a>
            </li>
            <li class="flex items-center">
              <svg class="w-4 h-4 mx-1" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"></path></svg>
              <span class={PALETTE.corrente}>{dim.etichettaPlurale}</span>
            </li>
          </ol>
        </nav>
        <h1 class={PALETTE.h1}>{titolo}</h1>
        <p class={PALETTE.testo}>{voci.length} {voci.length === 1 ? 'pagina disponibile' : 'pagine disponibili'}</p>
      </div>
    </div>

    <div class="container mx-auto px-4 max-w-6xl py-8">
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {voci.map((v) => (
          <li>
            <a href={hrefFiltro(sezione, slugDimensione, v.slug)}
               class="flex items-baseline justify-between gap-3 px-4 py-3 bg-white rounded-xl border border-gray-100 shadow-sm hover:border-gray-300 hover:shadow-md transition-all">
              <span class="font-medium text-gray-900">{v.etichetta}</span>
              <span class="text-sm text-gray-400 shrink-0">{v.totale}</span>
            </a>
          </li>
        ))}
      </ul>

      {altreDimensioni.length > 0 && (
        <Sorelle titolo="Esplora anche" voci={altreDimensioni} />
      )}
    </div>
  </main>
  )}
</Layout>
