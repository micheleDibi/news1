# ============================================================
# .env.example — copia in .env e compila con i valori reali
# ============================================================

# --- Supabase / PostgreSQL ---
DATABASE_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT_REF>.supabase.co:5432/postgres
DATABASE_POOLER_HOST=aws-1-eu-central-1.pooler.supabase.com
DATABASE_POOLER_PORT=6543
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_SSLMODE=require
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
SUPABASE_KEY=<SERVICE_ROLE_KEY>

# --- OpenAI ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- OCR ---
TESSERACT_CMD=tesseract
OCR_LANGUAGE=ita+eng

# --- Scraping ---
SOURCE_ROOT_URL=https://opencoesione.gov.it/it/opportunita_2021_2027/
SCRAPER_CONCURRENCY=5
SCRAPER_TIMEOUT_SECONDS=30
SCRAPER_RETRY_MAX=3
SCRAPER_RETRY_DELAY_SECONDS=5
IMPORTO_PLAUSIBILE_THRESHOLD=1000

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Logging ---
LOG_LEVEL=INFO
LOG_JSON=true
